{
  "env": {
    "PLAYWRIGHT_MCP_BROWSER": "chromium",
    "PLAYWRIGHT_MCP_HEADLESS": "true"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.railway)",
      "Read(./.dev.vars)",
      "Read(./dev.vars)"
    ],
    "ask": [
      "Bash(git push*)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "modern-web-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "resend@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "posthog@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "marketing@anthropic-plugin-directory": true,
    "design@anthropic-plugin-directory": true,
    "brand-voice@anthropic-plugin-directory": true,
    "searchfit-seo@anthropic-plugin-directory": true,
    "build@project-studio": true,
    "brand@project-studio": true,
    "copy@project-studio": true
  },
  "extraKnownMarketplaces": {
    "project-studio": {
      "source": {
        "source": "git",
        "url": "git@mostafgomgithub.com:MostafGom/ai-project-studio.git"
      },
      "autoUpdate": true
    }
  }
}
