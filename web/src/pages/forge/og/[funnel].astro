---
/* Social share images, 1200×630, one per funnel. Rendered to public/forge/og/<funnel>.png by `pnpm images`. */
import '../../../styles/base.css';
import { PHOTOS } from '../../../components/clients/forge/photos';
export function getStaticPaths() {
  return [
    { params: { funnel: 'checkout' }, props: { kicker: 'Forge 12 · men 35–50', title: 'Stronger at 45 than you were at <em>30.</em>', foot: 'Week-Four Guarantee', photo: PHOTOS.rack, focus: '50% 35%' } },
    { params: { funnel: 'vsl-checkout' }, props: { kicker: 'Free training', title: 'The least training that makes a 45-year-old <em>stronger.</em>', foot: 'Six lifts · one rule · three sessions', photo: PHOTOS.bar, focus: '50% 50%' } },
    { params: { funnel: 'ebook' }, props: { kicker: 'Free guide', title: 'Three sessions. Six lifts. <em>Four weeks, written out.</em>', foot: 'The 3-Session Week', photo: PHOTOS.rack, focus: '50% 35%' } },
    { params: { funnel: 'calendar' }, props: { kicker: 'Free Strength Audit', title: 'Twenty minutes. <em>One plan, written for you.</em>', foot: '20 minutes with Daniel', photo: PHOTOS.daniel, focus: '50% 25%' } },
    { params: { funnel: 'vsl-call' }, props: { kicker: 'For the man with a “but”', title: 'Your case isn’t the exception. <em>It’s an adjustment.</em>', foot: 'Old back · hotel gyms · first time at 50', photo: PHOTOS.bar, focus: '50% 50%' } },
    { params: { funnel: 'default' }, props: { kicker: 'Forge Fitness Online', title: 'Stronger at 45 than you were at <em>30.</em>', foot: 'Three sessions a week · six lifts · 12 weeks', photo: PHOTOS.rack, focus: '50% 35%' } },
  ];
}
const { kicker, title, foot, photo, focus } = Astro.props;
---
<!doctype html>
<html lang="en" data-client="forge">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>og</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter+Tight:wght@600;700&display=swap" />
    <style is:global>html,body{margin:0;background:var(--color-bg)} h1 em{font-style:normal;color:var(--color-primary)}</style></head>
  <body>
    <div class="relative overflow-hidden bg-bg text-fg" style="width:1200px;height:630px">
      <img src={photo} alt="" class="absolute inset-y-0 right-0 h-full w-[560px] object-cover" style={`object-position:${focus}`} />
      <div class="absolute inset-y-0 right-[360px] w-[200px] bg-[linear-gradient(90deg,var(--color-bg),transparent)]"></div>
      <div class="absolute inset-x-0 top-0 h-2 bg-primary"></div>
      <div class="absolute left-16 top-16 w-[680px]">
        <p class="text-xl font-bold uppercase tracking-[0.16em] text-primary">{kicker}</p>
        <h1 class="mt-5 font-display text-[84px] font-extrabold leading-[0.88]" set:html={title} />
      </div>
      <div class="absolute bottom-14 left-16 flex items-center gap-5">
        <span class="rounded-sm bg-accent px-4 py-2 font-display text-2xl font-extrabold uppercase text-accent-fg">Forge Fitness</span>
        <span class="text-xl font-semibold text-fg-muted">{foot}</span>
      </div>
    </div>
  </body>
</html>
