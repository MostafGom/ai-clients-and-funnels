---
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SessionPlanner from '../../../components/clients/forge/art/SessionPlanner.astro';
---
<Layout client="forge" funnel="calendar" step="confirmed" title="You’re booked" noindex>
  <Container size="wide" class="py-12 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="text-base font-semibold text-success">Booked</p>
        <h1 class="mt-2 text-h1 font-semibold">Done.<br /><span class="italic">Daniel will see you then.</span></h1>
        <p class="mt-5 text-lead text-fg-muted">The invite is in your inbox with a reschedule link. Two things before the call and we’ll get further.</p>
        <ol class="mt-8 space-y-4 text-lg">
          <li class="flex gap-3"><span class="grid size-8 shrink-0 place-items-center rounded-pill bg-inverse font-display text-lg text-accent">1</span>Write your last two weeks of training, one line each. “None” is a fine answer.</li>
          <li class="flex gap-3"><span class="grid size-8 shrink-0 place-items-center rounded-pill bg-inverse font-display text-lg text-accent">2</span>Note anything that hurts and what you’ve been told about it.</li>
        </ol>
      </div>
      <SessionPlanner heading="Your week, while you’re here" compact />
    </div>
  </Container>
</Layout>
