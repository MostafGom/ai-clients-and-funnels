---
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Plates from '../../../components/clients/forge/art/Plates.astro';
---
<Layout client="forge" funnel="vsl-call" step="confirmed" title="You’re booked" noindex>
  <Container size="prose" class="py-16 sm:py-24 text-center">
    <Plates count={5} class="mx-auto h-auto w-56 text-fg" />
    <p class="mt-6 text-xs font-semibold uppercase tracking-[0.18em] text-success">Booked</p>
    <h1 class="mt-2 text-h1 font-extrabold">Done. <span class="text-primary">Daniel has your application.</span></h1>
    <p class="mt-5 text-lead text-fg-muted">The invite’s in your inbox. Write your last two weeks of training in one line each and bring them. That’s the whole prep.</p>
  </Container>
</Layout>
