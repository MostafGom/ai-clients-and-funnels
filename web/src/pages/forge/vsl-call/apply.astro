---
/* Conversational three-step application. Posts to /api/lead (funnel=vsl-call), redirects to /book. */
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import Input from '../../../components/ui/Input.astro';
const field = 'w-full rounded-md border border-border-strong bg-surface px-4 py-3 text-base focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary-soft';
const chip = 'cursor-pointer rounded-pill border-2 border-border-strong px-4 py-2 font-semibold text-fg transition has-checked:border-primary has-checked:bg-primary-soft has-checked:text-primary';
const buts = [['back', 'Old back'], ['joint', 'Shoulder or knee'], ['travel', 'Travel 2+ weeks a month'], ['new', 'Never lifted'], ['none', 'None of these']];
---
<Layout client="forge" funnel="vsl-call" step="apply" title="Apply for a Strength Audit" noindex>
  <Container size="prose" class="py-12 sm:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Five questions · two minutes · Daniel reads every one</p>
    <h1 class="mt-2 text-h1 font-extrabold">Tell Daniel about your week</h1>
    <div class="mt-6 h-1 w-full overflow-hidden bg-surface-2"><div class="h-full w-1/3 bg-primary transition-[width] duration-300" data-progress></div></div>
    <p class="mt-2 text-sm text-fg-muted"><span data-step-label>Step 1 of 3 · Your situation</span></p>

    <form method="post" action="/api/lead" class="mt-8 rounded-lg bg-surface p-7 border-t-4 border-primary shadow-pop sm:p-9" data-apply novalidate>
      <input type="hidden" name="client" value="forge" /><input type="hidden" name="funnel" value="vsl-call" /><input type="hidden" name="redirect" value="/forge/vsl-call/book" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <fieldset data-step="1" class="space-y-6">
        <legend class="sr-only">Your situation</legend>
        <label class="block"><span class="mb-1.5 block text-sm font-semibold">How old are you?</span>
          <select name="age" required class={field}><option value="">Select…</option><option value="35-39">35–39</option><option value="40-44">40–44</option><option value="45-50">45–50</option><option value="50+">Over 50</option></select></label>
        <div><p class="mb-2 text-sm font-semibold">Which of these apply? Pick all that do.</p>
          <div class="flex flex-wrap gap-2">{buts.map(([v, l]) => <label class={chip}><input type="checkbox" name="but" value={v} class="sr-only" />{l}</label>)}</div></div>
        <label class="hidden" data-if="back"><span class="mb-1.5 block text-sm font-semibold">The back: seen a physio or doctor about it?</span><select name="back_seen" class={field}><option>Yes</option><option>No</option></select></label>
        <label class="hidden" data-if="joint"><span class="mb-1.5 block text-sm font-semibold">The shoulder or knee: seen a physio or doctor about it?</span><select name="joint_seen" class={field}><option>Yes</option><option>No</option></select></label>
        <label class="hidden" data-if="travel"><span class="mb-1.5 block text-sm font-semibold">Travel: how many weeks a month?</span><select name="travel_weeks" class={field}><option>2</option><option>3</option><option>4</option></select></label>
      </fieldset>

      <fieldset data-step="2" class="hidden space-y-6">
        <legend class="sr-only">Your training</legend>
        <label class="block"><span class="mb-1.5 block text-sm font-semibold">The last two weeks of training</span><select name="recent" required class={field}><option value="">Select…</option><option>None</option><option>Sporadic</option><option>Consistent</option></select></label>
        <label class="block"><span class="mb-1.5 block text-sm font-semibold">Equipment</span><select name="kit" required class={field}><option value="">Select…</option><option value="gym">Full gym</option><option value="rack">Home rack</option><option value="db">Dumbbells</option><option value="hotel">Hotel gyms</option></select></label>
        <label class="block"><span class="mb-1.5 block text-sm font-semibold">Hours a week you actually have</span><select name="hours" required class={field}><option value="">Select…</option><option>2</option><option>3</option><option>4 or more</option></select></label>
      </fieldset>

      <fieldset data-step="3" class="hidden space-y-6">
        <legend class="sr-only">You</legend>
        <Input label="First name" name="name" autocomplete="given-name" required />
        <Input label="Email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
        <label class="block"><span class="mb-1.5 block text-sm font-semibold">Best time for a call</span><select name="best_time" class={field}><option>6 a.m.</option><option>Lunchtime</option><option>Evening</option></select></label>
      </fieldset>

      <div class="mt-8 flex items-center justify-between gap-4">
        <Button type="button" variant="ghost" size="md" class="invisible" data-back>Back</Button>
        <Button type="button" size="lg" data-next>Continue</Button>
        <Button type="submit" size="lg" data-submit hidden>Send my application</Button>
      </div>
      <p class="mt-4 text-sm text-fg-muted">You’ll pick a time on the next page. Daniel reads your answers before the call.</p>
      <p class="mt-3 hidden text-sm text-danger" data-error>Something went wrong. Please try again.</p>
    </form>
  </Container>

  <script>
    const form = document.querySelector<HTMLFormElement>('form[data-apply]')!;
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
    const labels = ['Step 1 of 3 · Your situation', 'Step 2 of 3 · Your training', 'Step 3 of 3 · You'];
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!, back = form.querySelector<HTMLButtonElement>('[data-back]')!, submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const prog = document.querySelector<HTMLElement>('[data-progress]')!, label = document.querySelector('[data-step-label]')!;
    let i = 0;
    const show = () => {
      steps.forEach((s, k) => s.classList.toggle('hidden', k !== i));
      prog.style.width = `${((i + 1) / steps.length) * 100}%`; label.textContent = labels[i];
      back.classList.toggle('invisible', i === 0); next.hidden = i === steps.length - 1; submit.hidden = i !== steps.length - 1;
      steps[i].querySelector<HTMLElement>('select, input:not([type=hidden]):not(.sr-only), textarea')?.focus();
      window.funnel?.track('application_step', { step: i + 1 });
    };
    const valid = () => { const fields = [...steps[i].querySelectorAll<HTMLInputElement>('input, select, textarea')]; for (const f of fields) if (!f.checkValidity()) { f.reportValidity(); return false; } return true; };
    next.addEventListener('click', () => { if (valid()) { i++; show(); } });
    back.addEventListener('click', () => { i--; show(); });
    // Conditional follow-ups
    const buts = form.querySelectorAll<HTMLInputElement>('input[name=but]');
    const sync = () => { const on = new Set([...buts].filter((b) => b.checked).map((b) => b.value)); form.querySelectorAll<HTMLElement>('[data-if]').forEach((el) => el.classList.toggle('hidden', !on.has(el.dataset.if!))); if (on.has('none')) buts.forEach((b) => { if (b.value !== 'none') b.checked = false; }); };
    buts.forEach((b) => b.addEventListener('change', (e) => { if ((e.target as HTMLInputElement).value !== 'none' && (e.target as HTMLInputElement).checked) (form.querySelector('input[name=but][value=none]') as HTMLInputElement).checked = false; sync(); }));
    form.addEventListener('submit', async (e) => {
      e.preventDefault(); if (!valid()) return;
      submit.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json(); if (!res.ok) throw new Error(data.error);
        window.funnel?.track('application_submitted'); location.assign(data.redirect || '/forge/vsl-call/book');
      } catch { form.querySelector('[data-error]')?.classList.remove('hidden'); submit.disabled = false; }
    });
    show();
  </script>
</Layout>
