---
/* Forge · VSL → call. Script: clients/forge/funnels/vsl-call/VSL-SCRIPT.md · Copy: COPY.md · Section map: DESIGN-PLAN.md */
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import StickyCTA from '../../../components/funnel/StickyCTA.astro';
import { loadVslScript } from '../../../lib/vsl-script';
import IronBand from '../../../components/clients/forge/IronBand.astro';
import PhotoHero from '../../../components/clients/forge/PhotoHero.astro';
import PhotoBand from '../../../components/clients/forge/PhotoBand.astro';
import VslStage from '../../../components/clients/forge/VslStage.astro';
import ClientLedgers from '../../../components/clients/forge/ClientLedgers.astro';
import { PHOTOS } from '../../../components/clients/forge/photos';
import { CLIENTS } from '../../../components/clients/forge/data';
const script = loadVslScript('clients/forge/funnels/vsl-call/VSL-SCRIPT.md');
const CTA = 'Apply for a Strength Audit';
const apply = '/forge/vsl-call/apply';
const cases = [
  { tag: 'The old back', trap: 'Avoiding the hinge entirely, so the back never gets stronger, so it keeps hurting.', swap: 'Trap-bar or Romanian deadlift, a box under the squat, loads that start embarrassingly light.' },
  { tag: 'Hotel gyms', trap: 'A program that needs a particular gym. Three weeks a month it isn’t there.', swap: 'The same session for dumbbells and a cable stack. The rule doesn’t care which room you’re in.' },
  { tag: 'First time at 50', trap: 'Loading a pattern you haven’t learned yet, with a video and a guess.', swap: 'Four weeks on three lifts, starting weights set by someone who’s watched you move.' },
  { tag: 'Quits at week three', trap: 'A program that gets heavier exactly when your week gets harder.', swap: 'Load only when the last set was clean, a lighter week 7, and someone who asks for your log.' },
];
const caseRows: Record<string, string[][]> = {
  'Mark T.': [['Deadlift (trap bar)', '70 kg', '130 kg'], ['Squat (box)', '60 kg', '110 kg'], ['Back pain', 'weekly', 'none since wk 5']],
  'James O.': [['Deadlift', '80 kg', '140 kg'], ['Sessions', '—', '34 of 36'], ['Hotels', '—', '9 cities']],
  'Ravi S.': [['Pull-ups', '0', '6'], ['Squat', '40 kg', '90 kg'], ['Resting HR', '72', '61']],
};
const quotes: Record<string, string> = { 'Mark T.': 'I expected to be managed around my back. Instead it got strong.', 'James O.': 'Same session, different room.', 'Ravi S.': 'He set my weights. I stopped guessing.' };
const clients = CLIENTS.map((c) => ({ ...c, q: quotes[c.who], rows: caseRows[c.who].map(([name, before, after]) => ({ name, before, after })) }));
---
<Layout client="forge" funnel="vsl-call" step="vsl" title="Your case isn’t the exception. It’s an adjustment." description="An old back, hotel gyms, a first time under a bar at 50, or quitting at week three: four cases, the swap for each, and how to get a strength plan written for yours. Free.">

  <VslStage script={script} kicker="For the man with a “but”" sub="Four cases, the trap in each, the swap for each, and how to get a plan written for yours. Free." meta="Then a five-question application." cta={CTA} href={apply} photo={PHOTOS.garageRack} lifts={[{ name: 'Deadlift', before: 70, after: 130 }, { name: 'Squat', before: 60, after: 110 }, { name: 'Pull-ups', before: 0, after: 6, unit: 'reps' }]}>
    <Fragment slot="headline">Your case isn’t the exception. <span class="text-primary">It’s an adjustment.</span></Fragment>
  </VslStage>

  <div class="reveal" data-reveal>
    <IronBand tone="chalk" pad="lg">
      <Container size="wide">
        <h2 class="max-w-[18ch] font-display text-h1 font-extrabold uppercase">Four “buts.” Four swaps.</h2>
        <div class="mt-12 border-t-4 border-inverse-fg">
          <div class="hidden grid-cols-[1fr_1.4fr_1.4fr] gap-8 border-b border-inverse-fg/20 py-3 text-xs font-semibold uppercase tracking-[0.18em] opacity-70 md:grid" aria-hidden="true"><span>Your case</span><span>The trap</span><span>The swap</span></div>
          {cases.map((c) => (
            <div class="grid gap-3 border-b border-inverse-fg/20 py-6 md:grid-cols-[1fr_1.4fr_1.4fr] md:gap-8">
              <h3 class="font-display text-3xl font-extrabold leading-none">{c.tag}</h3>
              <p class="text-lg opacity-75"><span class="font-semibold md:sr-only">The trap: </span>{c.trap}</p>
              <p class="text-lg font-medium"><span class="font-semibold md:sr-only">The swap: </span>{c.swap}</p>
            </div>
          ))}
        </div>
      </Container>
    </IronBand>

    <IronBand pad="lg">
      <Container size="wide" class="grid gap-5 md:grid-cols-2">
        <div class="rounded-lg border-t-4 border-success bg-surface p-7 sm:p-10">
          <h2 class="font-display text-h3 font-extrabold uppercase text-success">This audit is for you if</h2>
          <ul class="mt-5 space-y-3 text-lg">{['You’re 35 to 50 and your week comes with a “but.”', 'You want a plan written for your case, not a template.', 'You can give three 45-minute sessions a week.', 'You’ll write down your last two weeks before we talk.'].map((t) => <li class="flex gap-3"><span class="mt-2.5 size-2 shrink-0 bg-success" aria-hidden="true"></span>{t}</li>)}</ul>
        </div>
        <div class="rounded-lg border border-border-strong p-7 sm:p-10">
          <h2 class="font-display text-h3 font-extrabold uppercase text-fg-muted">It isn’t for you if</h2>
          <ul class="mt-5 space-y-3 text-lg text-fg-muted">{['A doctor has told you not to lift.', 'You want a six-day bodybuilding split.', 'You want someone to make you show up.'].map((t) => <li class="flex gap-3"><span class="mt-2.5 size-2 shrink-0 bg-fg-subtle" aria-hidden="true"></span>{t}</li>)}</ul>
        </div>
      </Container>
    </IronBand>

    <PhotoBand src={PHOTOS.chalkCoach} alt="A lifter in his fifties chalking his hands" focus="55% 35%">Fifty is not too late. It’s a different start.</PhotoBand>

    <IronBand tone="graphite" pad="lg" edge>
      <Container size="wide">
        <h2 class="max-w-[22ch] font-display text-h1 font-extrabold uppercase">Three “exceptions,” <span class="text-primary">twelve weeks later.</span></h2>
        <ClientLedgers class="mt-12" clients={clients} rows={3} />
      </Container>
    </IronBand>

    <PhotoHero src={PHOTOS.daniel} alt="Daniel Reyes, strength coach" focus="50% 25%" side="right" minH="min-h-[80svh]">
      <h2 class="font-display text-display font-extrabold uppercase">Twenty minutes.<br /><span class="text-primary">A plan for yours.</span></h2>
      <p class="mt-6 max-w-[46ch] text-lead text-fg/85">Tell Daniel your case, your equipment and the hours you actually have. He writes your three sessions, your swaps and your starting weights while you talk.</p>
      <div class="mt-8 flex flex-col items-start gap-3">
        <Button href={apply} size="xl" data-cta="close">{CTA}</Button>
        <p class="text-sm text-fg-muted">Free · five questions, two minutes · Daniel reads every one</p>
      </div>
    </PhotoHero>
    <StickyCTA href={apply} label={CTA} note="Free 20-minute audit" showAfter={700} />
  </div>
  <script>document.querySelectorAll<HTMLElement>('[data-cta]').forEach((el) => el.addEventListener('click', () => window.funnel?.track('cta_click', { placement: el.dataset.cta })));</script>
</Layout>
