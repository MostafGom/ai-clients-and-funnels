---
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import CheckoutForm from '../../../components/funnel/CheckoutForm.astro';
import OrderBump from '../../../components/funnel/OrderBump.astro';
import FaqList from '../../../components/clients/forge/FaqList.astro';
import { PHOTOS } from '../../../components/clients/forge/photos';
import Avatar from '../../../components/clients/forge/art/scenes/Avatar.astro';
---
<Layout client="forge" funnel="vsl-checkout" step="checkout" title="Checkout" noindex>
  <Container size="wide" class="py-10 sm:py-16">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(360px,460px)] lg:gap-16">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">You watched the training. Session one is tonight.</p>
        <h1 class="mt-3 text-h1 font-extrabold">Your order</h1>
        <div class="mt-8 flex items-start gap-5 rounded-lg border-t-4 border-primary bg-surface p-6 shadow-card sm:p-7">
          <img src={PHOTOS.rack} alt="" width="80" height="80" class="size-20 shrink-0 rounded-md object-cover object-[50%_35%]" />
          <div class="flex-1">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div><p class="font-display text-3xl font-extrabold uppercase leading-none">Forge 12</p><p class="mt-1 text-fg-muted">12-week program, three equipment tracks, filmed lifts, check-ins, bonuses</p></div>
              <p class="text-right"><span class="block text-sm text-fg-subtle line-through">$297</span><span class="font-display text-5xl font-extrabold text-primary">$197</span></p>
            </div>
          </div>
        </div>
        <h2 class="mt-10 text-h3 font-extrabold">What happens in the next 10 minutes</h2>
        <ol class="mt-4 space-y-3 text-lg">
          {['Pay on Stripe’s secure page. Cards, Apple Pay, Google Pay.', 'Your login lands in your inbox within a minute.', 'Pick your equipment track and watch the six lifts (14 minutes).', 'Session one: 45 minutes, tonight or tomorrow at 6 a.m.'].map((t, i) => <li class="flex gap-3"><span class="grid size-9 shrink-0 place-items-center rounded-sm bg-primary font-display text-xl font-extrabold text-primary-fg">{i + 1}</span><span>{t}</span></li>)}
        </ol>
        <figure class="mt-10 rounded-lg bg-primary p-6 text-primary-fg sm:p-8">
          <blockquote class="font-display text-2xl font-bold uppercase leading-tight sm:text-3xl">“Watched it on the train home, bought it at the station, did session one the next morning.”</blockquote>
          <figcaption class="mt-4 flex items-center gap-3 text-sm font-semibold"><Avatar who="Owen P." size={36} />Owen P., 46</figcaption>
        </figure>
        <FaqList class="mt-10" items={[
          { q: 'When do I get access?', a: 'Within a minute of paying. The welcome email has your login.' },
          { q: 'Which equipment track should I pick?', a: 'The one you’ll actually use three times a week. You can switch tracks any time.' },
          { q: 'Can I add coaching later?', a: 'Yes, from inside the program, and you only pay the difference.' },
        ]} />
      </div>
      <aside class="lg:sticky lg:top-8 lg:self-start">
        <div class="rounded-lg border-t-4 border-primary bg-surface p-7 shadow-pop sm:p-9">
          <p class="rounded-md border-l-4 border-accent bg-bg px-4 py-3 text-sm text-fg-muted"><span class="block font-display text-xl font-extrabold uppercase text-fg">Week-Four Guarantee</span> If all six lifts haven’t gone up by week four, full refund.</p>
          <CheckoutForm client="forge" funnel="vsl-checkout" priceKey="main" successPath="/forge/vsl-checkout/upsell" cancelPath="/forge/vsl-checkout/checkout" label="Continue to secure payment">
            <OrderBump title="The Mobility Minimum" price="$37" description="Ten minutes a day for backs, hips and shoulders, built to run before a session or at your desk. The men who do it are the men whose joints stop talking. Normally $77. Only offered on this page." priceKey="bump" />
          </CheckoutForm>
        </div>
      </aside>
    </div>
  </Container>
  <script>document.querySelector<HTMLInputElement>('input[name=bump]')?.addEventListener('change', (e) => window.funnel?.track('bump_toggled', { on: (e.target as HTMLInputElement).checked }));</script>
</Layout>
