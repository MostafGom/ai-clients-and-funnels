---
/* Forge · VSL → checkout. Script: clients/forge/funnels/vsl-checkout/VSL-SCRIPT.md · Copy: COPY.md · Section map: DESIGN-PLAN.md */
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import StickyCTA from '../../../components/funnel/StickyCTA.astro';
import { loadVslScript } from '../../../lib/vsl-script';
import IronBand from '../../../components/clients/forge/IronBand.astro';
import PhotoHero from '../../../components/clients/forge/PhotoHero.astro';
import PhotoBand from '../../../components/clients/forge/PhotoBand.astro';
import VslStage from '../../../components/clients/forge/VslStage.astro';
import NumberWall from '../../../components/clients/forge/NumberWall.astro';
import ResultsTicker from '../../../components/clients/forge/ResultsTicker.astro';
import ClientLedgers from '../../../components/clients/forge/ClientLedgers.astro';
import OfferBlock from '../../../components/clients/forge/OfferBlock.astro';
import FaqList from '../../../components/clients/forge/FaqList.astro';
import { PHOTOS } from '../../../components/clients/forge/photos';
import { CTA, GUARANTEE_SHORT, MECHANISM, RESULTS_12 } from '../../../components/clients/forge/data';

const script = loadVslScript('clients/forge/funnels/vsl-checkout/VSL-SCRIPT.md');
const minutes = Math.ceil(script.totalSeconds / 60);
const checkout = '/forge/vsl-checkout/checkout';
const faq = [
  { q: 'How long does each session take?', a: 'Forty-five minutes including the warm-up. If you have 35, the program tells you what to cut.' },
  { q: 'I have an old back, shoulder or knee.', a: 'The “train around” table swaps the lift that bothers you for one that trains the same pattern. If a doctor has told you not to lift, follow the doctor.' },
  { q: 'I only have a home rack, or I travel.', a: 'Three equipment tracks and the Hotel Gym Card: the same session on a different page.' },
  { q: 'I always quit at week three.', a: 'Forge 12 adds load only when a set is clean and deloads in week seven, so it gets lighter exactly when other programs get heavier. And the weekly check-in asks for your log.' },
  { q: 'Do I have to diet?', a: 'No. The Plate Rule is one page. Leaner comes from the sessions and the rule, not from counting.' },
  { q: 'When do I get access?', a: 'Immediately. Session one can be tonight; it’s 45 minutes.' },
];
---
<Layout client="forge" funnel="vsl-checkout" step="vsl" title={`The least training that makes a 45-year-old stronger (${minutes}-minute training)`} description={`Free ${minutes}-minute training from a strength coach and former physiotherapist: why volume isn't the lever after forty, the three that are, and the 12-week program built around them.`}>

  <VslStage script={script} kicker={`Free ${minutes}-minute training · men 35–50`} sub="Six lifts, one rule, three sessions a week. A former physiotherapist on what actually moves the bar after forty, and why the programs you quit were built for someone else." meta="Taught by a strength coach and former physiotherapist." cta={CTA} href={checkout} photo={PHOTOS.deadliftLockout} lifts={[{ name: 'Squat', before: 60, after: 110 }, { name: 'Deadlift', before: 70, after: 130 }, { name: 'Bench', before: 50, after: 80 }, { name: 'Press', before: 30, after: 50 }]}>
    <Fragment slot="headline">The least training that makes a 45-year-old <span class="text-primary">stronger.</span></Fragment>
  </VslStage>

  <ResultsTicker items={RESULTS_12} />

  <div class="reveal" data-reveal>
    <IronBand pad="lg">
      <Container size="wide">
        <h2 class="max-w-[20ch] font-display text-h1 font-extrabold uppercase">Everything from the training, <span class="text-primary">programmed.</span></h2>
        <NumberWall class="mt-12" items={MECHANISM} />
      </Container>
    </IronBand>

    <PhotoBand src={PHOTOS.press} alt="A lifter in his fifties holding a barbell in the front rack" focus="50% 30%">Built for men who aren’t 25.</PhotoBand>

    <IronBand tone="graphite" pad="lg" edge>
      <Container size="wide">
        <h2 class="font-display text-h1 font-extrabold uppercase">Twelve weeks later</h2>
        <ClientLedgers class="mt-12" rows={3} />
      </Container>
    </IronBand>

    <OfferBlock href={checkout} heading="Forge 12. Twelve weeks. Three equipment tracks." />

    <IronBand pad="lg">
      <Container size="wide" class="grid gap-10 lg:grid-cols-[1fr_2fr]">
        <h2 class="font-display text-h2 font-extrabold uppercase">Before you decide</h2>
        <FaqList items={faq} />
      </Container>
    </IronBand>

    <PhotoHero src={PHOTOS.deadlift} alt="A man in his forties setting up a deadlift in a dark gym" focus="62% 45%" side="right" minH="min-h-[80svh]">
      <h2 class="font-display text-display font-extrabold uppercase">Your first<br />session<br /><span class="text-primary">is tonight.</span></h2>
      <p class="mt-6 max-w-[46ch] text-lead text-fg/85">Forty-five minutes. Six lifts you already know the names of. A rule that tells you what to do next.</p>
      <div class="mt-8 flex flex-col items-start gap-3">
        <Button href={checkout} size="xl" data-cta="close">{CTA}</Button>
        <p class="text-sm text-fg-muted">{GUARANTEE_SHORT}</p>
      </div>
    </PhotoHero>
    <StickyCTA href={checkout} label={CTA} note="Week-Four Guarantee" showAfter={700} />
  </div>
  <script>
    document.querySelectorAll<HTMLElement>('[data-cta]').forEach((el) => el.addEventListener('click', () => window.funnel?.track('cta_click', { placement: el.dataset.cta })));
  </script>
</Layout>
