---
/* Forge · long-form sales page. Copy: clients/forge/funnels/checkout/COPY.md · Section map: clients/forge/DESIGN-PLAN.md */
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import StickyCTA from '../../../components/funnel/StickyCTA.astro';
import IronBand from '../../../components/clients/forge/IronBand.astro';
import PhotoHero from '../../../components/clients/forge/PhotoHero.astro';
import PhotoBand from '../../../components/clients/forge/PhotoBand.astro';
import NumberWall from '../../../components/clients/forge/NumberWall.astro';
import ResultsTicker from '../../../components/clients/forge/ResultsTicker.astro';
import CoachStory from '../../../components/clients/forge/CoachStory.astro';
import ClientLedgers from '../../../components/clients/forge/ClientLedgers.astro';
import OfferBlock from '../../../components/clients/forge/OfferBlock.astro';
import FaqList from '../../../components/clients/forge/FaqList.astro';
import PlateLoader from '../../../components/clients/forge/art/PlateLoader.astro';
import WeekRibbon from '../../../components/clients/forge/art/WeekRibbon.astro';
import { PHOTOS } from '../../../components/clients/forge/photos';
import { CTA, GUARANTEE_SHORT, MECHANISM, PHASES, RESULTS_12 } from '../../../components/clients/forge/data';

const checkout = '/forge/checkout/checkout';
const label = 'text-xs font-semibold uppercase tracking-[0.18em]';
const myths = [
  { name: 'The six-day split', truth: 'Built for a man who recovers by morning. On your calendar it collapses by week three, and so does your confidence.' },
  { name: 'The high-intensity app', truth: 'Twenty minutes of jumping on a cranky knee. It burns, it sweats, it makes nothing stronger.' },
  { name: '“Just walk more”', truth: 'Good advice, and not a strength program. Walking won’t fix the back that complains at the suitcase.' },
  { name: 'The trainer you couldn’t schedule', truth: 'The work was right. The appointment wasn’t. A program should fit around a 7 a.m. call.' },
];
const faq = [
  { q: 'How long does each session take?', a: 'Forty-five minutes including the warm-up. Two main lifts, one assistance lift. If you have 35, the program tells you what to cut.' },
  { q: 'I have an old back, shoulder or knee.', a: 'The “train around” table swaps the lift that bothers you for one that trains the same pattern without the pain, and the warm-up is built around desk shoulders and stiff hips. If a doctor has told you not to lift, follow the doctor.' },
  { q: 'I only have a home rack, or I travel.', a: 'Three equipment tracks: full gym, home rack and barbell, dumbbells or hotel gym. The Hotel Gym Card is the same session on a different page.' },
  { q: 'I always quit at week three.', a: 'Week three is where volume-based programs collapse. Forge 12 adds load only when a set is clean and deloads in week seven, so it gets lighter exactly when other programs get heavier. The weekly check-in asks for your log, which is harder to ignore than an app.' },
  { q: 'Do I have to diet?', a: 'No. The Plate Rule is one page: protein at each meal, a plate that’s half vegetables, and the one change that matters for strength.' },
  { q: '$197 is more than an app.', a: 'It’s less than three sessions with a trainer, and it includes twelve weeks of check-ins and a guarantee that the bar goes up. If it doesn’t, it’s free.' },
  { q: 'When do I get access?', a: 'Immediately. The first session can be tonight; it’s 45 minutes.' },
  { q: 'Is Daniel qualified?', a: 'Daniel is a strength coach and former physiotherapist. Nothing in the program replaces medical advice. If you’re under a doctor’s care, follow their guidance.' },
];
---
<Layout client="forge" funnel="checkout" step="sales" title="Forge 12: stronger at 45 than you were at 30, three sessions a week" description="The 12-week strength program for men 35 to 50. Six lifts, three 45-minute sessions a week, a progression rule that removes every decision. Week-Four Guarantee.">

  <!-- 1. Hero: photo + proof in the first viewport -->
  <PhotoHero src={PHOTOS.deadlift} alt="A man in his forties setting up a deadlift in a dark gym" focus="62% 45%" minH="min-h-0 lg:min-h-[92svh]">
    <p class:list={[label, 'text-primary']}>Forge 12 · for men 35–50</p>
    <h1 class="mt-5 font-display text-[clamp(3.25rem,1.4rem+5vw,6rem)] leading-[0.86] font-extrabold uppercase"><span class="block">Stronger at 45</span> <span class="block">than you were</span> <span class="block text-primary">at 30.</span></h1>
    <p class="mt-7 max-w-[52ch] text-lead text-fg/85">Three 45-minute sessions a week. Six lifts. One rule that adds weight when the last set was clean. Twelve weeks, built for men who aren’t 25 and don’t pretend to be.</p>
    <div class="mt-8 flex flex-col items-start gap-3">
      <Button href={checkout} size="xl" data-cta="hero">{CTA}</Button>
      <p class="text-sm text-fg-muted">If all six lifts haven’t gone up by week four, full refund.</p>
    </div>
    <ul slot="strip" class="flex flex-wrap gap-x-8 gap-y-2 text-sm text-fg-muted">
      <li><strong class="font-display text-xl font-bold text-fg">1,900+</strong> men coached since 2011</li>
      <li><strong class="font-display text-xl font-bold text-fg">4.8/5</strong> from 640 reviews</li>
      <li>Coached by a <strong class="text-fg">former physiotherapist</strong></li>
      <li>Mark, 47: deadlift <strong class="font-display text-xl font-bold text-fg">70 → 130 kg</strong></li>
    </ul>
  </PhotoHero>

  <ResultsTicker items={RESULTS_12} />

  <!-- 2. The scene -->
  <IronBand pad="lg">
    <Container size="wide" class="grid items-center gap-10 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)]">
      <div class="relative">
        <img src={PHOTOS.desk} alt="A man at his desk in the evening, tired" width="1600" height="1067" class="aspect-[4/3] w-full rounded-lg object-cover grayscale-[35%]" loading="lazy" />
        <p class="absolute -bottom-6 left-5 font-display text-[clamp(4rem,2rem+8vw,9rem)] font-extrabold leading-none text-primary tabular-nums sm:left-8" aria-hidden="true">6:40<span class="text-fg">pm</span></p>
      </div>
      <div class="max-w-[56ch] pt-6 lg:pt-0">
        <h2 class="font-display text-h2 font-extrabold uppercase">It’s 6:40 p.m. The gym bag has been in the boot since Monday.</h2>
        <div class="mt-6 space-y-5 text-lg text-fg/85">
          <p>It’s Thursday. You meant to go at lunch; a call ran over. You meant to go after work; the kids. You’ll go tomorrow, which is what you said last Thursday.</p>
          <p>You used to train. Now your back talks to you when you pick up a suitcase, you fade at three, and the belt is a notch past where it should be.</p>
          <p class="font-semibold text-fg">It isn’t that you don’t know what to do. Every plan you’ve opened assumes ninety minutes a day, a 24-year-old’s recovery, and nothing else to run.</p>
        </div>
      </div>
    </Container>
  </IronBand>

  <!-- 3. Myth wall -->
  <IronBand tone="chalk" pad="lg">
    <Container size="wide">
      <h2 class="max-w-[20ch] font-display text-h1 font-extrabold uppercase">The programs weren’t wrong. They weren’t for you.</h2>
      <ul class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-2">
        {myths.map((m) => (
          <li class="border-t-4 border-inverse-fg pt-5">
            <p class="font-display text-3xl font-extrabold uppercase leading-none line-through decoration-primary decoration-4">{m.name}</p>
            <p class="mt-3 max-w-[46ch] text-lg opacity-80">{m.truth}</p>
          </li>
        ))}
      </ul>
    </Container>
  </IronBand>

  <!-- 4. Mechanism as numbers -->
  <IronBand pad="lg">
    <Container size="wide">
      <div class="grid items-end gap-8 lg:grid-cols-2">
        <h2 class="font-display text-h1 font-extrabold uppercase">Volume isn’t the lever. <span class="text-primary">Progression is.</span></h2>
        <p class="max-w-[54ch] text-lead text-fg-muted">Six days fails in week three, and the failure feels like a character flaw. It’s arithmetic. The Forge Protocol is the least training that moves the bar.</p>
      </div>
      <NumberWall class="mt-12" items={MECHANISM} />
    </Container>
  </IronBand>

  <PhotoBand src={PHOTOS.press} alt="A lifter in his fifties holding a barbell in the front rack" focus="50% 30%">Built for men who aren’t 25.</PhotoBand>

  <!-- 5. The rule (signature moment) -->
  <IronBand tone="graphite" pad="lg" edge>
    <Container size="wide" class="grid items-center gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div>
        <p class:list={[label, 'text-fg-muted']}>The rule</p>
        <h2 class="mt-4 font-display text-h1 font-extrabold uppercase">Add when clean.<br /><span class="text-primary">Repeat when not.</span></h2>
        <p class="mt-6 max-w-[46ch] text-lead text-fg-muted">When the last set is clean, add 2.5 kg next time. When it isn’t, repeat. That’s the entire decision, every session, for twelve weeks.</p>
      </div>
      <PlateLoader to={130} weeks={12} caption="Mark T., 47: deadlift 70 kg in week 1, 130 kg in week 12." />
    </Container>
  </IronBand>

  <!-- 6. Twelve-week track -->
  <IronBand pad="lg">
    <Container size="wide">
      <h2 class="max-w-[20ch] font-display text-h1 font-extrabold uppercase">Twelve weeks. Three phases. One rule.</h2>
      <p class="mt-5 max-w-[60ch] text-lead text-fg-muted">Every session is the same shape: eight-minute warm-up, two main lifts, one assistance lift, done in 45 minutes.</p>
      <WeekRibbon phases={PHASES} class="mt-12" />
    </Container>
  </IronBand>

  <!-- 7. Proof -->
  <IronBand tone="graphite" pad="lg">
    <Container size="wide">
      <h2 class="max-w-[22ch] font-display text-h1 font-extrabold uppercase">Three men. Twelve weeks. <span class="text-primary">Three different problems.</span></h2>
      <ClientLedgers class="mt-12" />
    </Container>
  </IronBand>

  <PhotoBand src={PHOTOS.chalkHands} alt="Chalking hands at the rack before a set" focus="50% 40%" />

  <!-- 8. Daniel -->
  <CoachStory heading="I was a physio before I was a coach. That’s why the program starts with your back.">
    <p>Since 2011 most of the men I coach have been 35 to 50: founders, surgeons, engineers, lawyers. A lot to carry and not much time.</p>
    <p>The warm-up exists because of desk shoulders. The “train around” table exists because of old backs. The three-session structure exists because the men who kept training were the ones whose plan fit a real week.</p>
    <p class="font-semibold text-fg">The bar goes up for nearly all of them by week four. That’s why I guarantee it.</p>
  </CoachStory>

  <!-- 9. For / not for -->
  <IronBand tone="graphite" pad="md">
    <Container size="wide" class="grid gap-5 md:grid-cols-2">
      <div class="rounded-lg bg-bg p-7 sm:p-10">
        <h2 class="font-display text-h3 font-extrabold uppercase text-success">This is for you if</h2>
        <ul class="mt-5 space-y-3 text-lg">{['You’re 35 to 50.', 'You can give three 45-minute sessions a week.', 'You have a barbell or a pair of dumbbells.', 'You want numbers that go up, not a photo.'].map((t) => <li class="flex gap-3"><span class="mt-2.5 size-2 shrink-0 bg-success" aria-hidden="true"></span>{t}</li>)}</ul>
      </div>
      <div class="rounded-lg border border-border-strong p-7 sm:p-10">
        <h2 class="font-display text-h3 font-extrabold uppercase text-fg-muted">This isn’t for you if</h2>
        <ul class="mt-5 space-y-3 text-lg text-fg-muted">{['A doctor has told you not to lift.', 'You want a six-day bodybuilding split.', 'You want a program that doesn’t ask you to show up three times.'].map((t) => <li class="flex gap-3"><span class="mt-2.5 size-2 shrink-0 bg-fg-subtle" aria-hidden="true"></span>{t}</li>)}</ul>
      </div>
    </Container>
  </IronBand>

  <!-- 10. Offer: stack, price, guarantee -->
  <OfferBlock href={checkout} coaching sub="A trainer three times a week is $960 a month. Twelve more weeks of guessing cost nothing and change nothing. Forge 12 is $197, once." />

  <!-- 11. FAQ -->
  <IronBand pad="lg">
    <Container size="wide" class="grid gap-10 lg:grid-cols-[1fr_2fr]">
      <h2 class="font-display text-h2 font-extrabold uppercase">Before you decide</h2>
      <FaqList items={faq} />
    </Container>
  </IronBand>

  <!-- 12. Close -->
  <PhotoHero src={PHOTOS.bar} alt="A man benching a loaded barbell in a dark gym" focus="50% 55%" side="right" minH="min-h-[80svh]">
    <h2 class="font-display text-display font-extrabold uppercase">Your first<br />session<br /><span class="text-primary">is tonight.</span></h2>
    <p class="mt-6 max-w-[46ch] text-lead text-fg/85">Forty-five minutes. Six lifts you already know the names of. A rule that tells you what to do next. Twelve weeks from now you’ll have numbers, and they’ll be bigger than they were at 30.</p>
    <div class="mt-8 flex flex-col items-start gap-3">
      <Button href={checkout} size="xl" data-cta="close">{CTA}</Button>
      <p class="text-sm text-fg-muted">{GUARANTEE_SHORT}</p>
    </div>
  </PhotoHero>

  <StickyCTA href={checkout} label={CTA} note="Week-Four Guarantee" showAfter={900} />
  <script>
    document.querySelectorAll<HTMLElement>('[data-cta]').forEach((el) => el.addEventListener('click', () => window.funnel?.track('cta_click', { placement: el.dataset.cta })));
  </script>
</Layout>
