---
/* First Shares · checkout thanks. Copy: clients/firstshares/funnels/checkout/COPY.md → "/thanks" */
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import Highlight from '../../../components/clients/firstshares/art/Highlight.astro';
import { PHOTOS } from '../../../components/clients/firstshares/photos';
const courseUrl = 'https://learn.firstshares.example.com'; // [CLIENT] member-area login
const steps = ['Set your password.', 'Download the Money Map worksheet.', 'Watch lesson 1. Twelve minutes.', 'Put Saturday morning in your calendar.'];
const when = [['Now', 'Your login.'], ['Tomorrow', 'The money map, explained.'], ['Day 3', 'What to have ready for Saturday.'], ['Week 2', 'The account walkthroughs unlock.'], ['Week 5', 'The bad-year plan, before you need it.']];
---
<Layout client="firstshares" funnel="checkout" step="thanks" title="Welcome to First Shares" noindex>
  <Container size="wide" class="py-12 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
      <div>
        <p class="text-sm font-semibold text-success">You’re in</p>
        <h1 class="mt-3 text-h1 font-display font-extrabold text-balance">Welcome to First Shares. <Highlight>Lesson 1 is 12 minutes.</Highlight></h1>
        <p class="mt-5 text-lead text-fg-muted">Your receipt and login are on the way. Here’s the next ten minutes.</p>
        <ol class="mt-8 space-y-3 text-lg">
          {steps.map((t, i) => <li class="flex gap-3"><span class="grid size-9 shrink-0 place-items-center rounded-md border-2 border-fg font-display font-extrabold">{i + 1}</span><span class="pt-1">{t}</span></li>)}
        </ol>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href={courseUrl} size="xl" data-cta="open-lesson-1">Open lesson 1</Button>
          <Button type="button" variant="secondary" size="xl" data-ics>Add Saturday to my calendar</Button>
        </div>
      </div>
      <div class="overflow-hidden rounded-xl bg-surface shadow-card">
        <img src={PHOTOS.saturday} alt="A woman with coffee and a laptop in a bright kitchen" width="2000" height="1333" loading="lazy" class="h-52 w-full object-cover object-[35%_40%]" />
        <div class="p-6 sm:p-8">
          <h2 class="text-h3 font-display font-bold">What arrives when</h2>
          <dl class="mt-4 grid grid-cols-[6rem_1fr] gap-x-4 gap-y-3 border-t border-border pt-4">
            {when.map(([d, t]) => <><dt class="font-display font-bold text-primary">{d}</dt><dd>{t}</dd></>)}
          </dl>
        </div>
      </div>
    </div>
  </Container>
  <script>
    document.querySelector('[data-ics]')?.addEventListener('click', () => {
      const d = new Date(); d.setDate(d.getDate() + ((6 - d.getDay() + 7) % 7 || 7)); d.setHours(9, 0, 0, 0);
      const p = (n: number) => String(n).padStart(2, '0');
      const stamp = (x: Date) => `${x.getFullYear()}${p(x.getMonth() + 1)}${p(x.getDate())}T${p(x.getHours())}${p(x.getMinutes())}00`;
      const ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//First Shares//EN', 'BEGIN:VEVENT', `DTSTART:${stamp(d)}`, `DTEND:${stamp(new Date(d.getTime() + 60 * 60000))}`, 'SUMMARY:First Shares · Saturday setup', 'DESCRIPTION:Money Map + lesson 1. Coffee, laptop, 401(k) login.', 'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
      const a = document.createElement('a'); a.href = 'data:text/calendar;charset=utf-8,' + encodeURIComponent(ics); a.download = 'first-shares-saturday.ics'; a.click();
      window.funnel?.track('saturday_added_to_calendar');
    });
    document.querySelectorAll<HTMLElement>('[data-cta]').forEach((el) => el.addEventListener('click', () => window.funnel?.track('cta_click', { placement: el.dataset.cta })));
  </script>
</Layout>
