---
/* First Shares · checkout. Copy: clients/firstshares/funnels/checkout/COPY.md → "/checkout" */
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import CheckoutForm from '../../../components/funnel/CheckoutForm.astro';
import OrderBump from '../../../components/funnel/OrderBump.astro';
import FaqList from '../../../components/clients/firstshares/FaqList.astro';
import { PHOTOS, personPhoto } from '../../../components/clients/firstshares/photos';
const steps = ['Pay on Stripe’s secure page: cards, Apple Pay, Google Pay.', 'Your login arrives within a minute.', 'Lesson 1 is 12 minutes: the money map.', 'Put Saturday morning in your calendar.'];
---
<Layout client="firstshares" funnel="checkout" step="checkout" title="Checkout" noindex>
  <img src={PHOTOS.notebookHands} alt="" width="2000" height="1333" class="h-28 w-full object-cover object-[50%_45%] sm:h-36" />
  <Container size="wide" class="py-10 sm:py-14">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(360px,460px)] lg:gap-16">
      <div>
        <p class="text-sm font-semibold text-primary">Saturday morning, sorted</p>
        <h1 class="mt-2 text-h1 font-display font-extrabold">Your order</h1>
        <div class="mt-8 rounded-xl bg-primary-soft p-6 sm:p-7">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="max-w-[38ch]"><p class="font-display text-3xl font-extrabold leading-none tracking-[-0.03em]">First Shares</p><p class="mt-2 text-fg-muted">The six-week setup course: 22 lessons, account walkthroughs, the Money Map, the Bad-Year Plan, the Q&amp;A library and 2 bonuses.</p></div>
            <p class="text-right font-display leading-none"><span class="block text-sm text-fg-muted line-through">$559</span><span class="text-5xl font-extrabold tracking-[-0.04em] text-primary">$297</span></p>
          </div>
        </div>
        <h2 class="mt-10 text-h3 font-display font-bold">What happens in the next 10 minutes</h2>
        <ol class="mt-4 space-y-3 text-lg">
          {steps.map((t, i) => <li class="flex gap-3"><span class="grid size-9 shrink-0 place-items-center rounded-md border-2 border-fg font-display font-extrabold">{i + 1}</span><span class="pt-1">{t}</span></li>)}
        </ol>
        <figure class="mt-10 rounded-xl bg-inverse p-6 text-inverse-fg sm:p-8">
          <blockquote class="font-display text-2xl leading-snug font-bold">“I bought it on a Tuesday and opened my Roth that Saturday. I’d been ‘about to’ for six years.”</blockquote>
          <figcaption class="mt-4 flex items-center gap-3 text-sm font-semibold"><img src={personPhoto('Denise R.')} alt="" width="40" height="40" class="size-10 rounded-pill object-cover" />Denise R., 41, ICU nurse</figcaption>
        </figure>
        <FaqList class="mt-12" heading="Quick answers" items={[
          { q: 'When do I get access?', a: 'Within a minute of paying. The welcome email has your login.' },
          { q: 'Can I do it on my phone?', a: 'The lessons, yes. Opening accounts is easier on a laptop, so most students save that for Saturday.' },
          { q: 'What if I change my mind?', a: 'The 30-day guarantee: if your first account isn’t open and funded within 30 days, email us for a full refund.' },
        ]} />
      </div>
      <aside class="lg:sticky lg:top-16 lg:self-start">
        <div class="rounded-xl bg-surface p-7 shadow-pop sm:p-9">
          <p class="rounded-md border-l-4 border-primary bg-primary-soft px-4 py-3 text-sm"><span class="block font-display text-lg font-bold">30-day “first account” guarantee</span>Account not open and funded in 30 days? Full refund. No forms, no call.</p>
          <CheckoutForm client="firstshares" funnel="checkout" priceKey="main" successPath="/firstshares/checkout/upsell" cancelPath="/firstshares/checkout/checkout" label="Continue to secure payment">
            <OrderBump title="the Portfolio Kit" price="$47" description="The spreadsheet behind the setup: your three accounts and funds on one tab, the contribution planner with the 1%-a-year raise, and printable checklists for every account. Normally $77. Only offered here." priceKey="bump" />
          </CheckoutForm>
          <p class="mt-4 text-xs text-fg-muted">Education only, not investment advice. First Shares never sells funds or takes commissions.</p>
        </div>
      </aside>
    </div>
  </Container>
  <script>document.querySelector<HTMLInputElement>('input[name=bump]')?.addEventListener('change', (e) => window.funnel?.track('bump_toggled', { on: (e.target as HTMLInputElement).checked }));</script>
</Layout>
