---
import Layout from '../../../layouts/FunnelLayout.astro';
import ThankYou from '../../../components/funnel/ThankYou.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import { getClient } from '../../../lib/clients';
const client = getClient('demo');
---
<Layout client="demo" funnel="ebook" step="thanks" title="Check your inbox" noindex>
  <ThankYou eyebrow="Sent" headline="Your playbook is on its way." body="Check your inbox (and promotions tab) in the next minute. While you wait, here’s the fastest way to put it to work.">
    <Card pad="lg" class="mx-auto max-w-lg text-left">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Next step</p>
      <h2 class="mt-2 text-h3 font-semibold">Want the playbook installed for you in 45 minutes?</h2>
      <p class="mt-2 text-fg-muted">Book a free strategy call. We map your next 90 days together and you leave with a filled-in tracker.</p>
      <Button href="/demo/calendar/book" class="mt-6" full>Book my free strategy call</Button>
      <p class="mt-4 text-center text-sm"><a class="text-fg-muted underline-offset-4 hover:underline" href={client.leadMagnet!.downloadUrl}>Or download the PDF directly</a></p>
    </Card>
  </ThankYou>
</Layout>
