---
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import CalendarEmbed from '../../../components/funnel/CalendarEmbed.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
---
<Layout client="demo" funnel="calendar" step="book" title="Pick a time" noindex>
  <Container class="py-12 sm:py-16">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow>Step 2 of 2</Eyebrow>
      <h1 class="mt-3 text-h1 font-semibold">Pick a time for your strategy call</h1>
      <p class="mt-4 text-lead text-fg-muted">45 minutes. Video call. You’ll receive a calendar invite and a 5-minute prep sheet.</p>
    </div>
    <CalendarEmbed client="demo" confirmedPath="/demo/calendar/confirmed" class="mt-10" />
  </Container>
</Layout>
