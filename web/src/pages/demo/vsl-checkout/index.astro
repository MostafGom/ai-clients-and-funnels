---
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import Button from '../../../components/ui/Button.astro';
import Section from '../../../components/ui/Section.astro';
import VideoPlayer from '../../../components/funnel/VideoPlayer.astro';
import PriceCard from '../../../components/funnel/PriceCard.astro';
import Guarantee from '../../../components/funnel/Guarantee.astro';
import FAQ from '../../../components/funnel/FAQ.astro';
import Testimonials from '../../../components/funnel/Testimonials.astro';
---
<Layout client="demo" funnel="vsl-checkout" step="vsl" title="The 90-Day Pipeline System" description="Watch the training, then get the complete system: course, scripts, tracker, and 90 days of accountability.">
  <Container class="pt-12 sm:pt-16 text-center">
    <Eyebrow>Free training · 18 min</Eyebrow>
    <h1 class="mx-auto mt-4 max-w-4xl text-h1 font-semibold">Install a client pipeline that books 3 to 5 qualified calls a week, in 90 days.</h1>
    <VideoPlayer provider="vimeo" src="76979871" revealAfter={10} class="mx-auto mt-10 max-w-4xl" />
    <div class="reveal mt-8 flex flex-col items-center" data-reveal>
      <Button href="#offer" size="xl">Get the 90-Day Pipeline System</Button>
      <p class="mt-3 text-sm text-fg-muted">One payment · 30-day guarantee</p>
    </div>
  </Container>
  <Section id="offer" tone="muted" class="reveal" data-reveal>
    <Container size="prose">
      <div class="text-center"><Eyebrow class="mb-4">The offer</Eyebrow><h2 class="text-h2 font-semibold">Everything from the training, built for you</h2></div>
      <PriceCard class="mt-10" name="The 90-Day Pipeline System" price="$497" compareAt="$997" badge="Launch price" highlight features={['6-module course: the full system, 3h 40m', 'Script vault: 31 outreach and follow-up scripts', 'The pipeline tracker (Notion + Sheets)', '12 weekly accountability check-ins by email', 'Lifetime updates']}>
        <Button href="/demo/vsl-checkout/checkout" size="xl" full>Get instant access · $497</Button>
      </PriceCard>
    </Container>
  </Section>
  <Section><Guarantee days={30} body="Run the first two modules. If you don’t have a weekly rhythm you believe in, email us for a full refund. No forms, no calls." /></Section>
  <Section tone="muted"><Testimonials headline="Students, 90 days later" items={[
    { quote: 'Week 6: first fully booked week of my career.', name: 'Priya N.', role: 'Ops consultant', result: 'Booked out' },
    { quote: 'The scripts alone paid for it in the first follow-up I sent.', name: 'Marcus T.', role: 'Fractional CFO', result: 'ROI in 1 week' },
    { quote: 'Finally a system, not a motivational speech.', name: 'Elena R.', role: 'Brand strategist', result: '+$7k MRR' },
  ]} /></Section>
  <Section><FAQ items={[
    { q: 'How much time does it take each week?', a: 'About 3 hours, split across five short blocks. The rhythm is designed around a full client load.' },
    { q: 'Does it work for my niche?', a: 'If you sell expertise to businesses and your clients talk to each other, yes. Over 40 niches so far.' },
    { q: 'Is there a payment plan?', a: 'Yes. Choose 3 × $179 at checkout.' },
  ]} /></Section>
</Layout>
