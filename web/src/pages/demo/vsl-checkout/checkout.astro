---
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Card from '../../../components/ui/Card.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import CheckoutForm from '../../../components/funnel/CheckoutForm.astro';
import OrderBump from '../../../components/funnel/OrderBump.astro';
import Countdown from '../../../components/funnel/Countdown.astro';
---
<Layout client="demo" funnel="vsl-checkout" step="checkout" title="Checkout" noindex>
  <Container class="py-12 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <Eyebrow>Almost there</Eyebrow>
        <h1 class="mt-3 text-h1 font-semibold">Your order</h1>
        <Card class="mt-8">
          <div class="flex items-start justify-between gap-4">
            <div><p class="font-semibold">The 90-Day Pipeline System</p><p class="text-sm text-fg-muted">Course + scripts + tracker + 12 check-ins</p></div>
            <p class="font-display text-2xl font-semibold">$497</p>
          </div>
          <div class="mt-5 border-t border-border pt-5"><Countdown minutes={20} label="Launch price held for" /></div>
        </Card>
        <p class="mt-6 text-sm text-fg-muted">You’ll finish payment on Stripe’s secure page. Cards, Apple Pay, Google Pay.</p>
      </div>
      <Card pad="lg" highlight>
        <CheckoutForm client="demo" funnel="vsl-checkout" priceKey="main" successPath="/demo/vsl-checkout/upsell" cancelPath="/demo/vsl-checkout/checkout" label="Continue to secure payment">
          <OrderBump title="the Proposal Template Pack" price="$47" description="The 5 proposal templates that closed $1.2M for our students. Normally $97." priceKey="bump" />
        </CheckoutForm>
      </Card>
    </div>
  </Container>
</Layout>
