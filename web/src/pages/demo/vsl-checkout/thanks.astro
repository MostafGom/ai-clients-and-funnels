---
import Layout from '../../../layouts/FunnelLayout.astro';
import ThankYou from '../../../components/funnel/ThankYou.astro';
import Card from '../../../components/ui/Card.astro';
---
<Layout client="demo" funnel="vsl-checkout" step="thanks" title="Welcome" noindex>
  <ThankYou eyebrow="Order complete" headline="Welcome to the 90-Day Pipeline System." body="Your receipt and login details are on their way to your inbox. Start with Module 1 today, it takes 25 minutes.">
    <Card pad="lg" class="mx-auto max-w-lg text-left"><p class="font-semibold">Your first 3 steps</p><ol class="mt-3 list-decimal space-y-2 pl-5 text-fg-muted"><li>Open the welcome email and set your password.</li><li>Duplicate the tracker into your Notion or Sheets.</li><li>Watch Module 1 and block your first weekly rhythm.</li></ol></Card>
  </ThankYou>
</Layout>
