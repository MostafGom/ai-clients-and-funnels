---
/* Lumen · VSL → checkout. Script: clients/lumen/funnels/vsl-checkout/VSL-SCRIPT.md · Copy: COPY.md */
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import StickyCTA from '../../../components/funnel/StickyCTA.astro';
import ScriptedVSL from '../../../components/funnel/ScriptedVSL.astro';
import { loadVslScript, fmtTime } from '../../../lib/vsl-script';
import NightBand from '../../../components/clients/lumen/NightBand.astro';
import StackTable from '../../../components/clients/lumen/StackTable.astro';
import FaqList from '../../../components/clients/lumen/FaqList.astro';
import ClaimFlag from '../../../components/clients/lumen/ClaimFlag.astro';
import Moon from '../../../components/clients/lumen/art/Moon.astro';
import NightLog from '../../../components/clients/lumen/art/NightLog.astro';
import MonitorFrame from '../../../components/clients/lumen/art/MonitorFrame.astro';
import StarField from '../../../components/clients/lumen/art/StarField.astro';

const script = loadVslScript('clients/lumen/funnels/vsl-checkout/VSL-SCRIPT.md');
const minutes = Math.ceil(script.totalSeconds / 60);
const CTA = 'Start tonight · $497';
const checkout = '/lumen/vsl-checkout/checkout';
const stack = [
  { name: 'The 7-night video program, three age tracks (4–12 mo, 1–2 yr, 2–3 yr)', why: 'The plan, night by night, for your baby’s age', value: '$397' },
  { name: 'Wake-window charts by age + the 10-minute bedtime script (printable)', why: 'Takes the guesswork out of tonight', value: '$47' },
  { name: 'The Kind Response Plan: the 2 a.m. decision tree', why: 'What to do at the waking, without crying it out', value: '$97' },
  { name: 'Nap plan + early-morning fix', why: 'So the days stop paying for the nights', value: '$67' },
  { name: 'Private parent community + weekly live Q&A with Maya (12 weeks)', why: 'A human to ask on night three', value: '$240' },
  { name: 'The Partner Page', why: 'One printable page so you both run the same plan', value: '$27', bonus: true },
  { name: 'Daycare & two-kids-one-room guides', why: 'For babies whose days aren’t yours to control', value: '$47', bonus: true },
  { name: 'Travel & regression protocols', why: 'For the trip next month and the 12-month regression', value: '$67', bonus: true },
];
const faq = [
  { q: 'Is there any crying it out?', a: 'No. Timing, a bedtime script, and the Kind Response Plan for wakings, where you stay with your baby. You’re in the room for every minute.' },
  { q: 'Reflux, teething, twins, daycare?', a: 'Every age track has adjustments for all four, and the weekly Q&A is where Maya handles your case live.' },
  { q: 'How much time does it take each night?', a: 'Fifteen minutes of video, then bedtime itself, which gets shorter every night.' },
  { q: 'When do I get access?', a: 'Within a minute of paying. Night one can be tonight.' },
  { q: 'My baby is under 4 months.', a: 'Newborn sleep is a different conversation. Email hello@lumensleep.example.com and we’ll point you right.' },
  { q: 'Can I pay in instalments?', a: 'Right now it’s one payment, lifetime access, with the 30-day guarantee. If instalments are a must, email us.' },
];
---
<Layout client="lumen" funnel="vsl-checkout" step="vsl" title={`Why your baby wakes at 2 a.m. (${minutes}-minute training)`} description={`Free ${minutes}-minute training: the forty-minute timing mistake behind the 2 a.m. party, and the kind seven-night way to fix it. For parents of 4-month to 3-year-olds. No cry-it-out.`}>

  <NightBand edge="none" pad="sm" stars={110} seed={5}>
    <Container size="content" class="pb-6">
      <p class="text-base font-bold text-accent-2">Free {minutes}-minute training for parents of 4-month to 3-year-olds</p>
      <h1 class="mt-4 max-w-[28ch] text-display font-semibold">Why your baby wakes at 2 a.m.,<br class="hidden sm:block" /> and the kind way to fix it<br class="hidden sm:block" /> in seven nights.</h1>
      <p class="mt-5 max-w-[60ch] text-lead text-inverse-fg/85">No cry-it-out. No forty tabs. One mechanism, one plan, and night one is tonight.</p>

      <div class="mt-10">
        <ScriptedVSL script={script} title="Play the training">
          <Fragment slot="art:stars"><Moon size={200} phase={0.78} /></Fragment>
          <Fragment slot="art:moon"><Moon size={200} phase={0.55} /></Fragment>
          <Fragment slot="art:dial">
            <svg viewBox="0 0 200 200" width="220" height="220" aria-hidden="true">
              <circle cx="100" cy="100" r="88" fill="var(--color-inverse-2)" stroke="var(--color-accent-2)" stroke-width="3" />
              <path d="M100 100 L100 22 A78 78 0 0 1 178 100 Z" fill="var(--color-success)" opacity="0.85" />
              <path d="M100 100 L178 100 A78 78 0 0 1 150 164 Z" fill="var(--color-primary)" opacity="0.9" />
              <text x="128" y="70" font-size="13" font-weight="700" fill="var(--color-inverse-fg)">window</text>
              <text x="118" y="150" font-size="12" font-weight="700" fill="var(--color-inverse-fg)">+40 min</text>
              <circle cx="100" cy="100" r="6" fill="var(--color-accent)" />
              <line x1="100" y1="100" x2="100" y2="30" stroke="var(--color-accent)" stroke-width="4" stroke-linecap="round" />
            </svg>
          </Fragment>
          <Fragment slot="art:log"><div class="w-full max-w-[260px] text-inverse-fg"><NightLog before={[1.5, 1.5, 2, 1.5, 2, 1.5, 2]} after={[4, 5, 7, 7.5, 10, 11, 11.3]} compact /></div></Fragment>
          <Fragment slot="art:stack"><MonitorFrame hours="11h 20m" night="Night 7" /></Fragment>
        </ScriptedVSL>
      </div>
      <p class="mt-4 text-sm text-inverse-fg/75">Reads itself, no sound needed. {fmtTime(script.totalSeconds)}. Taught by a certified pediatric sleep consultant<ClaimFlag /> to 2,300+ families<ClaimFlag />.</p>
      <p class="reveal mt-6" data-reveal><Button href={checkout} size="xl" data-cta="under-video">{CTA}</Button></p>
    </Container>
  </NightBand>

  <!-- Everything below is hidden until the reveal chapter -->
  <div class="reveal" data-reveal>
    <section class="bg-bg py-16 sm:py-24">
      <Container>
        <div class="max-w-[62ch]">
          <h2 class="text-h1 font-semibold">The Lumen Sleep Method.<br />Seven nights. Every age track.</h2>
          <p class="mt-5 text-lead text-fg-muted">Everything from the training, built night by night for your baby’s age. Fifteen minutes of video per night, then bedtime.</p>
        </div>
        <StackTable class="mt-10" items={stack} total="$989" price="$497" compareAt="$797" note="Values are the price of each item sold separately. Client to confirm before launch." />
        <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          <Button href={checkout} size="xl" data-cta="stack">{CTA}</Button>
          <p class="text-sm text-fg-muted">Instant access. Sleep-Through Guarantee. No cry-it-out.</p>
        </div>
      </Container>
    </section>

    <NightBand edgeTop="wave" edge="cloud" seed={41} stars={60} pad="md">
      <Container>
        <h2 class="text-h2 font-semibold">Seven nights later</h2>
        <div class="mt-10 grid gap-8 md:grid-cols-3">
          {[
            { m: { hours: '11h 20m', night: 'Night 7' }, q: 'Night 5 she slept ten hours. I cried. Happy crying, for once.', who: 'Jess M., 9-month-old' },
            { m: { hours: '10h 40m', night: 'Night 6' }, q: 'Night 6, both slept through.', who: 'Ines R., twins 11 months, reflux' },
            { m: { hours: '11h 05m', night: 'Night 7' }, q: 'It held through the trip.', who: 'Kwame & Lila, 2-year-old' },
          ].map((t) => (
            <figure class="flex flex-col items-start gap-5">
              <MonitorFrame hours={t.m.hours} night={t.m.night} />
              <blockquote class="text-lg">“{t.q}”</blockquote>
              <figcaption class="text-sm text-accent-2">{t.who}<ClaimFlag note="real family to be supplied" /></figcaption>
            </figure>
          ))}
        </div>
      </Container>
    </NightBand>

    <section class="bg-bg py-16 sm:py-20">
      <Container size="prose">
        <div class="relative rounded-xl border-[3px] border-accent bg-surface p-8 sm:p-12">
          <div class="absolute -top-8 left-8"><Moon size={64} phase={1} /></div>
          <h2 class="text-h2 font-semibold">The Sleep-Through Guarantee</h2>
          <p class="mt-5 text-lg">Run nights one to seven exactly as written. If nights six and seven aren’t the best two nights your family has had since your baby arrived, email <a class="font-bold underline underline-offset-4" href="mailto:hello@lumensleep.example.com">hello@lumensleep.example.com</a> within 30 days and we refund every cent. No forms, no call, no “but did you really try.”</p>
        </div>
      </Container>
    </section>

    <section class="bg-surface-2 py-16 sm:py-24">
      <Container>
        <h2 class="text-h2 font-semibold">Before you decide</h2>
        <FaqList items={faq} class="mt-6" />
      </Container>
    </section>

    <NightBand edgeTop="cloud" edge="none" seed={33} pad="lg">
      <Container size="prose" class="text-center">
        <div class="mx-auto w-fit"><Moon size={96} phase={1} /></div>
        <h2 class="mt-6 text-display font-semibold">Tonight is night one.</h2>
        <p class="mx-auto mt-6 max-w-[50ch] text-lead text-inverse-fg/85">Pick your age track, set tonight’s bedtime, run the script. Your login arrives in a minute.</p>
        <div class="mt-9 flex flex-col items-center gap-3">
          <Button href={checkout} size="xl" data-cta="close">{CTA}</Button>
          <p class="text-sm text-inverse-fg/75">Sleep-Through Guarantee · instant access · no crying it out</p>
        </div>
      </Container>
    </NightBand>
    <StickyCTA href={checkout} label={CTA} note="Sleep-Through Guarantee" showAfter={700} />
  </div>

  <script>
    document.querySelectorAll<HTMLElement>('[data-cta]').forEach((el) => el.addEventListener('click', () => window.funnel?.track('cta_click', { placement: el.dataset.cta })));
  </script>
</Layout>
