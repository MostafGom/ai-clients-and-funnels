---
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Card from '../../../components/ui/Card.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import CheckoutForm from '../../../components/funnel/CheckoutForm.astro';
import OrderBump from '../../../components/funnel/OrderBump.astro';
---
<Layout client="lumen" funnel="vsl-checkout" step="checkout" title="Checkout" noindex>
  <Container class="py-12 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <Eyebrow>Night one is tonight</Eyebrow>
        <h1 class="mt-3 text-h1 font-semibold">Your order</h1>
        <Card class="mt-8">
          <div class="flex items-start justify-between gap-4">
            <div><p class="font-semibold">The Lumen Sleep Method</p><p class="text-sm text-fg-muted">7-night program · all age tracks · community + live Q&A</p></div>
            <p class="font-display text-2xl font-semibold">$497</p>
          </div>
          <p class="mt-5 border-t border-border pt-5 text-sm text-fg-muted">Sleep-through guarantee: 30 days, full refund, no forms.</p>
        </Card>
        <p class="mt-6 text-sm text-fg-muted">Payment happens on Stripe’s secure page. Cards, Apple Pay, Google Pay. Login details arrive within a minute.</p>
      </div>
      <Card pad="lg" highlight>
        <CheckoutForm client="lumen" funnel="vsl-checkout" priceKey="main" successPath="/lumen/vsl-checkout/upsell" cancelPath="/lumen/vsl-checkout/checkout" label="Continue to secure payment">
          <OrderBump title="Nap Rescue" price="$37" description="The 40-minute mini-course that fixes 30-minute naps and the 5 a.m. club. Normally $97. Only here." priceKey="bump" />
        </CheckoutForm>
      </Card>
    </div>
  </Container>
</Layout>
