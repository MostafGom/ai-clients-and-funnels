---
import Layout from '../../../layouts/FunnelLayout.astro';
import ThankYou from '../../../components/funnel/ThankYou.astro';
import Card from '../../../components/ui/Card.astro';
---
<Layout client="lumen" funnel="calendar" step="confirmed" title="You’re booked" noindex>
  <ThankYou eyebrow="Booked" headline="Done. Maya will see you then." body="Invite’s in your inbox. Two tiny things before the call and we’ll get twice as far.">
    <Card pad="lg" class="mx-auto max-w-lg text-left">
      <ol class="list-decimal space-y-3 pl-5 text-fg">
        <li>Jot down the next 3 nights: bedtime start, asleep time, every wake-up. Phone notes are fine.</li>
        <li>Write the one thing you’d most like to be different by next week.</li>
      </ol>
    </Card>
  </ThankYou>
</Layout>
