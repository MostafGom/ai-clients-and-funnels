---
/* Lumen · VSL → call. Script: clients/lumen/funnels/vsl-call/VSL-SCRIPT.md · Copy: COPY.md */
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import StickyCTA from '../../../components/funnel/StickyCTA.astro';
import ScriptedVSL from '../../../components/funnel/ScriptedVSL.astro';
import { loadVslScript, fmtTime } from '../../../lib/vsl-script';
import NightBand from '../../../components/clients/lumen/NightBand.astro';
import Moon from '../../../components/clients/lumen/art/Moon.astro';
import NightLog from '../../../components/clients/lumen/art/NightLog.astro';
import MonitorFrame from '../../../components/clients/lumen/art/MonitorFrame.astro';
import ButIcon from '../../../components/clients/lumen/art/scenes/ButIcon.astro';
const script = loadVslScript('clients/lumen/funnels/vsl-call/VSL-SCRIPT.md');
const minutes = Math.ceil(script.totalSeconds / 60);
const CTA = 'Apply for a free Clarity Call';
const apply = '/lumen/vsl-call/apply';
---
<Layout client="lumen" funnel="vsl-call" step="vsl" title={`Every baby is different. Here’s the plan for yours. (${minutes}-minute video)`} description="Twins, reflux, daycare naps, two kids in one room. Four kinds of “different,” the adjustment for each, and how to get a sleep plan written for your baby. Free.">

  <NightBand edge="none" pad="sm" stars={110} seed={17} class="overflow-hidden">
    <Container size="content" class="pb-6">
      <p class="text-base font-bold text-accent-2">For babies with a “but”</p>
      <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold text-inverse-fg/85">
        {([['twins', 'Twins'], ['reflux', 'Reflux'], ['daycare', 'Daycare'], ['sibling', 'Sibling in the room'], ['travel', 'Travel']] as const).map(([k, l]) => <li class="inline-flex items-center gap-2 text-accent"><ButIcon kind={k} size={28} /><span class="text-inverse-fg/85">{l}</span></li>)}
      </ul>
      <h1 class="mt-4 max-w-[26ch] text-display font-semibold">Every baby is different.<br class="hidden sm:block" /> Here’s the plan for yours.</h1>
      <p class="mt-5 max-w-[60ch] text-lead text-inverse-fg/85">Four kinds of “different,” the adjustment for each, and how to get a plan written for your baby. Free.</p>
      <div class="mt-10">
        <ScriptedVSL script={script} title="Play the video">
          <Fragment slot="art:stars"><Moon size={200} phase={0.78} /></Fragment>
          <Fragment slot="art:moon"><Moon size={200} phase={0.5} /></Fragment>
          <Fragment slot="art:dial">
            <svg viewBox="0 0 200 200" width="220" height="220" aria-hidden="true">
              <circle cx="100" cy="100" r="88" fill="var(--color-inverse-2)" stroke="var(--color-accent-2)" stroke-width="3" />
              <path d="M100 100 L100 22 A78 78 0 0 1 178 100 Z" fill="var(--color-success)" opacity="0.85" />
              <path d="M100 100 L178 100 A78 78 0 0 1 150 164 Z" fill="var(--color-primary)" opacity="0.9" />
              <text x="128" y="70" font-size="13" font-weight="700" fill="var(--color-inverse-fg)">window</text>
              <text x="118" y="150" font-size="12" font-weight="700" fill="var(--color-inverse-fg)">+40 min</text>
              <circle cx="100" cy="100" r="6" fill="var(--color-accent)" /><line x1="100" y1="100" x2="100" y2="30" stroke="var(--color-accent)" stroke-width="4" stroke-linecap="round" />
            </svg>
          </Fragment>
          <Fragment slot="art:log"><div class="w-full max-w-[260px] text-inverse-fg"><NightLog before={[6, 5.5, 6, 6, 5.5, 6, 6]} after={[7, 8, 8, 9.5, 10, 11, 11]} compact /></div></Fragment>
          <Fragment slot="art:stack"><MonitorFrame hours="10h 40m" night="Night 6" /></Fragment>
        </ScriptedVSL>
      </div>
      <p class="mt-4 text-sm text-inverse-fg/75">Reads itself, no sound needed. {fmtTime(script.totalSeconds)}. Then a five-question application.</p>
      <p class="reveal mt-6" data-reveal><Button href={apply} size="xl" data-cta="under-video">{CTA}</Button></p>
    </Container>
  </NightBand>

  <div class="reveal" data-reveal>
    <section class="bg-bg py-16 sm:py-24">
      <Container>
        <div class="grid gap-8 md:grid-cols-2">
          <div class="rounded-xl bg-surface p-7 shadow-card sm:p-9">
            <h2 class="text-h3 font-semibold text-success">This call is for you if</h2>
            <ul class="mt-4 space-y-2 text-lg"><li>your baby is 4 months to 3 years,</li><li>your nights come with a “but”: twins, reflux, daycare, a sibling in the room, a trip,</li><li>you want a plan written for your baby, not a generic one,</li><li>you’ll log three nights before we talk.</li></ul>
          </div>
          <div class="rounded-xl border-2 border-dashed border-border-strong p-7 sm:p-9">
            <h2 class="text-h3 font-semibold text-fg-muted">It isn’t for you if</h2>
            <ul class="mt-4 space-y-2 text-lg text-fg-muted"><li>your baby is under 4 months (email us),</li><li>a pediatrician is managing a medical sleep issue,</li><li>you want someone to do bedtime for you.</li></ul>
          </div>
        </div>
        <div class="mt-10 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          <Button href={apply} size="xl" data-cta="fit">{CTA}</Button>
          <p class="text-sm text-fg-muted">Five questions, two minutes. Maya reads every one.</p>
        </div>
      </Container>
    </section>

    <NightBand edgeTop="wave" edge="none" seed={41} stars={60} pad="md">
      <Container>
        <h2 class="text-h2 font-semibold">Three “different” babies, seven nights later</h2>
        <div class="mt-10 grid gap-8 md:grid-cols-3">
          {[
            { m: { hours: '10h 40m', night: 'Night 6' }, q: 'Twins. Reflux. One room. She built a plan around all three.', who: 'Ines R., twins, 11 months' },
            { m: { hours: '11h 05m', night: 'Night 7' }, q: 'Daycare naps and a work trip. The daycare bedtime rule changed everything.', who: 'Kwame & Lila, 2-year-old' },
            { m: { hours: '9h 30m', night: 'Night 5' }, q: 'Reflux baby, feed moved before the script. Night five, nine and a half hours.', who: 'Priya K., 7-month-old' },
          ].map((t) => <figure class="flex flex-col items-start gap-5"><MonitorFrame hours={t.m.hours} night={t.m.night} /><blockquote class="text-lg">“{t.q}”</blockquote><figcaption class="text-sm text-accent-2">{t.who}</figcaption></figure>)}
        </div>
        <div class="mt-12 flex flex-col items-center gap-3 text-center">
          <Button href={apply} size="xl" data-cta="close">{CTA}</Button>
          <p class="text-sm text-inverse-fg/75">Free · 20 minutes · you leave with a plan card for your baby</p>
        </div>
      </Container>
    </NightBand>
    <StickyCTA href={apply} label={CTA} note="Free 20-minute call" showAfter={700} />
  </div>
  <script>
    document.querySelectorAll<HTMLElement>('[data-cta]').forEach((el) => el.addEventListener('click', () => window.funnel?.track('cta_click', { placement: el.dataset.cta })));
  </script>
</Layout>
