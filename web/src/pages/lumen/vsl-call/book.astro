---
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import CalendarEmbed from '../../../components/funnel/CalendarEmbed.astro';
---
<Layout client="lumen" funnel="vsl-call" step="book" title="Pick a time" noindex>
  <Container size="wide" class="py-12 sm:py-16">
    <p class="text-base font-bold text-primary">Last step</p>
    <h1 class="mt-2 text-h1 font-semibold">Pick a time</h1>
    <p class="mt-4 max-w-[60ch] text-lead text-fg-muted">Maya reads your application first, so the call starts with a plan, not a questionnaire. 20 minutes, phone or video.</p>
    <CalendarEmbed client="lumen" confirmedPath="/lumen/vsl-call/confirmed" class="mt-8" />
  </Container>
  <script>document.addEventListener('DOMContentLoaded', () => window.funnel?.track('booking_started'));</script>
</Layout>
