---
/* Conversational three-step application. Posts to /api/lead (funnel=vsl-call), redirects to /book. */
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import Input from '../../../components/ui/Input.astro';
const field = 'w-full rounded-md border border-border-strong bg-surface px-4 py-3 text-base focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary-soft';
const chip = 'cursor-pointer rounded-pill border-2 border-border-strong px-4 py-2 font-bold text-fg transition has-checked:border-primary has-checked:bg-primary-soft has-checked:text-primary';
const buts = [['twins', 'Twins'], ['reflux', 'Reflux'], ['daycare', 'Daycare'], ['sibling', 'Sibling in the room'], ['travel', 'Travel in the next month'], ['none', 'None of these']];
---
<Layout client="lumen" funnel="vsl-call" step="apply" title="Apply for a free Clarity Call" noindex>
  <Container size="prose" class="py-12 sm:py-20">
    <p class="text-base font-bold text-primary">Five questions · two minutes · Maya reads every one</p>
    <h1 class="mt-2 text-h1 font-semibold">Tell Maya about your baby</h1>
    <div class="mt-6 h-2 w-full overflow-hidden rounded-pill bg-surface-2"><div class="h-full w-1/3 rounded-pill bg-primary transition-[width] duration-300" data-progress></div></div>
    <p class="mt-2 text-sm text-fg-muted"><span data-step-label>Step 1 of 3 · Your baby</span></p>

    <form method="post" action="/api/lead" class="mt-8 rounded-xl bg-surface p-7 shadow-pop sm:p-9" data-apply novalidate>
      <input type="hidden" name="client" value="lumen" /><input type="hidden" name="funnel" value="vsl-call" /><input type="hidden" name="redirect" value="/lumen/vsl-call/book" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <fieldset data-step="1" class="space-y-6">
        <legend class="sr-only">Your baby</legend>
        <label class="block"><span class="mb-1.5 block text-sm font-bold">How old is your little one?</span>
          <select name="age" required class={field}><option value="">Select…</option><option value="4-5">4–5 months</option><option value="6-8">6–8 months</option><option value="9-12">9–12 months</option><option value="13-18">13–18 months</option><option value="19-36">19 months – 3 years</option></select></label>
        <div><p class="mb-2 text-sm font-bold">Which of these apply? Pick all that do.</p>
          <div class="flex flex-wrap gap-2">{buts.map(([v, l]) => <label class={chip}><input type="checkbox" name="but" value={v} class="sr-only" />{l}</label>)}</div></div>
        <label class="hidden" data-if="twins"><span class="mb-1.5 block text-sm font-bold">Twins: same room?</span><select name="twins_room" class={field}><option>Same room</option><option>Separate rooms</option></select></label>
        <label class="hidden" data-if="daycare"><span class="mb-1.5 block text-sm font-bold">Daycare: how many days a week?</span><select name="daycare_days" class={field}><option>1–2</option><option>3</option><option>4–5</option></select></label>
      </fieldset>

      <fieldset data-step="2" class="hidden space-y-6">
        <legend class="sr-only">Your nights</legend>
        <label class="block"><span class="mb-1.5 block text-sm font-bold">Usual bedtime (lights out)</span><input name="bedtime" type="time" value="19:30" class={field} /></label>
        <label class="block"><span class="mb-1.5 block text-sm font-bold">Wakings on a typical night</span><select name="wakings" required class={field}><option value="">Select…</option><option>0</option><option>1–2</option><option>3–4</option><option>5+</option></select></label>
        <label class="block"><span class="mb-1.5 block text-sm font-bold">What have you tried? <span class="font-normal text-fg-muted">(optional)</span></span><textarea name="tried" rows="3" class={field} placeholder="Be honest, we’ve tried the weird stuff too."></textarea></label>
      </fieldset>

      <fieldset data-step="3" class="hidden space-y-6">
        <legend class="sr-only">You</legend>
        <Input label="First name" name="name" autocomplete="given-name" required />
        <Input label="Email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
        <label class="block"><span class="mb-1.5 block text-sm font-bold">Best time for a call</span><select name="best_time" class={field}><option>Mornings</option><option>Nap time</option><option>Evenings</option></select></label>
      </fieldset>

      <div class="mt-8 flex items-center justify-between gap-4">
        <Button type="button" variant="ghost" size="md" class="invisible" data-back>Back</Button>
        <Button type="button" size="lg" data-next>Continue</Button>
        <Button type="submit" size="lg" data-submit hidden>Send my application</Button>
      </div>
      <p class="mt-4 text-sm text-fg-muted">You’ll pick a time on the next page. Maya reads your answers before the call.</p>
      <p class="mt-3 hidden text-sm text-danger" data-error>Something went wrong. Please try again.</p>
    </form>
  </Container>

  <script>
    const form = document.querySelector<HTMLFormElement>('form[data-apply]')!;
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
    const labels = ['Step 1 of 3 · Your baby', 'Step 2 of 3 · Your nights', 'Step 3 of 3 · You'];
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!, back = form.querySelector<HTMLButtonElement>('[data-back]')!, submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const prog = document.querySelector<HTMLElement>('[data-progress]')!, label = document.querySelector('[data-step-label]')!;
    let i = 0;
    const show = () => {
      steps.forEach((s, k) => s.classList.toggle('hidden', k !== i));
      prog.style.width = `${((i + 1) / steps.length) * 100}%`; label.textContent = labels[i];
      back.classList.toggle('invisible', i === 0); next.hidden = i === steps.length - 1; submit.hidden = i !== steps.length - 1;
      steps[i].querySelector<HTMLElement>('select, input:not([type=hidden]):not(.sr-only), textarea')?.focus();
      window.funnel?.track('application_step', { step: i + 1 });
    };
    const valid = () => { const fields = [...steps[i].querySelectorAll<HTMLInputElement>('input, select, textarea')]; for (const f of fields) if (!f.checkValidity()) { f.reportValidity(); return false; } return true; };
    next.addEventListener('click', () => { if (valid()) { i++; show(); } });
    back.addEventListener('click', () => { i--; show(); });
    // Conditional follow-ups
    const buts = form.querySelectorAll<HTMLInputElement>('input[name=but]');
    const sync = () => { const on = new Set([...buts].filter((b) => b.checked).map((b) => b.value)); form.querySelectorAll<HTMLElement>('[data-if]').forEach((el) => el.classList.toggle('hidden', !on.has(el.dataset.if!))); if (on.has('none')) buts.forEach((b) => { if (b.value !== 'none') b.checked = false; }); };
    buts.forEach((b) => b.addEventListener('change', (e) => { if ((e.target as HTMLInputElement).value !== 'none' && (e.target as HTMLInputElement).checked) (form.querySelector('input[name=but][value=none]') as HTMLInputElement).checked = false; sync(); }));
    form.addEventListener('submit', async (e) => {
      e.preventDefault(); if (!valid()) return;
      submit.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json(); if (!res.ok) throw new Error(data.error);
        window.funnel?.track('application_submitted'); location.assign(data.redirect || '/lumen/vsl-call/book');
      } catch { form.querySelector('[data-error]')?.classList.remove('hidden'); submit.disabled = false; }
    });
    show();
  </script>
</Layout>
