---
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Moon from '../../../components/clients/lumen/art/Moon.astro';
---
<Layout client="lumen" funnel="vsl-call" step="confirmed" title="You’re booked" noindex>
  <Container size="prose" class="py-16 sm:py-24 text-center">
    <div class="mx-auto w-fit"><Moon size={80} phase={0.85} /></div>
    <p class="mt-6 text-base font-bold text-success">Booked</p>
    <h1 class="mt-2 text-h1 font-semibold">Done. Maya has your application.</h1>
    <p class="mt-5 text-lead text-fg-muted">The invite’s in your inbox. Log the next three nights (bedtime, asleep, every waking) and bring them. That’s the whole prep.</p>
  </Container>
</Layout>
