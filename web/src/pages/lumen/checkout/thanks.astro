---
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import WakeWindowDial from '../../../components/clients/lumen/art/WakeWindowDial.astro';
import Moon from '../../../components/clients/lumen/art/Moon.astro';
const programUrl = 'https://app.lumensleep.example.com'; // [CLIENT] member-area login
---
<Layout client="lumen" funnel="checkout" step="thanks" title="Welcome. Night one is tonight." noindex>
  <Container size="wide" class="py-12 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="text-base font-bold text-success">You’re in</p>
        <h1 class="mt-2 text-h1 font-semibold">Welcome to the Lumen Sleep Method.<br />Night one is tonight.</h1>
        <p class="mt-5 text-lead text-fg-muted">Your receipt and login are on their way (check promotions if they’re hiding). Here’s the next ten minutes.</p>
        <ol class="mt-8 space-y-4 text-lg">
          <li class="flex gap-3"><span class="grid size-8 shrink-0 place-items-center rounded-pill bg-inverse text-sm font-bold text-inverse-fg">1</span>Open the welcome email and set your password.</li>
          <li class="flex gap-3"><span class="grid size-8 shrink-0 place-items-center rounded-pill bg-inverse text-sm font-bold text-inverse-fg">2</span>Pick your age track and print the wake-window chart.</li>
          <li class="flex gap-3"><span class="grid size-8 shrink-0 place-items-center rounded-pill bg-inverse text-sm font-bold text-inverse-fg">3</span>Watch Night 1. Fifteen minutes.</li>
          <li class="flex gap-3"><span class="grid size-8 shrink-0 place-items-center rounded-pill bg-inverse text-sm font-bold text-inverse-fg">4</span>Set tonight’s bedtime on the right and add it to your calendar.</li>
        </ol>
        <Button href={programUrl} size="xl" class="mt-9" data-cta="open-night-1">Open Night 1</Button>

        <h2 class="mt-12 text-h3 font-semibold">What arrives when</h2>
        <dl class="mt-4 grid gap-3 text-fg sm:grid-cols-[auto_1fr] sm:gap-x-6">
          <dt class="font-bold">Now</dt><dd>Your login.</dd>
          <dt class="font-bold">Tonight, 7 p.m.</dt><dd>Night 1 reminder with tonight’s bedtime.</dd>
          <dt class="font-bold">Night 3</dt><dd>The Kind Response Plan, before you need it.</dd>
          <dt class="font-bold">Night 4, 7 p.m.</dt><dd>The “don’t quit” check-in.</dd>
          <dt class="font-bold">Night 7</dt><dd>Lock-in, and how to keep it through the next regression.</dd>
        </dl>
      </div>
      <div class="relative">
        <div class="absolute -right-2 -top-6"><Moon size={72} phase={0.85} /></div>
        <WakeWindowDial heading="Tonight’s bedtime" compact>
          <Button type="button" variant="secondary" size="md" data-ics>Add bedtime to my calendar</Button>
        </WakeWindowDial>
      </div>
    </div>
  </Container>
  <script>
    document.querySelector('[data-ics]')?.addEventListener('click', () => {
      const t = document.querySelector('[data-bedtime]')?.textContent?.trim() || '7:00 pm';
      const m = t.match(/(\d+):(\d\d) (am|pm)/); if (!m) return;
      let h = Number(m[1]) % 12; if (m[3] === 'pm') h += 12;
      const d = new Date(); d.setHours(h, Number(m[2]), 0, 0); if (d < new Date()) d.setDate(d.getDate() + 1);
      const p = (n: number) => String(n).padStart(2, '0');
      const stamp = (x: Date) => `${x.getFullYear()}${p(x.getMonth() + 1)}${p(x.getDate())}T${p(x.getHours())}${p(x.getMinutes())}00`;
      const ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Lumen Sleep//EN', 'BEGIN:VEVENT', `DTSTART:${stamp(d)}`, `DTEND:${stamp(new Date(d.getTime() + 15 * 60000))}`, 'SUMMARY:Lights out (Lumen Sleep, Night 1)', 'DESCRIPTION:Run the 10-minute bedtime script. Earlier than feels normal is the point.', 'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
      const a = document.createElement('a'); a.href = 'data:text/calendar;charset=utf-8,' + encodeURIComponent(ics); a.download = 'lumen-bedtime.ics'; a.click();
      window.funnel?.track('bedtime_added_to_calendar');
    });
  </script>
</Layout>
