/* The 7-Night Bedtime Reset — the lead magnet as a designed, printable page.
   Content source: clients/lumen/funnels/ebook/GUIDE.md. Render: pnpm pdf → public/lumen/assets/bedtime-reset.pdf */
import '../../../styles/base.css';
import Moon from '../../../components/clients/lumen/art/Moon.astro';
import StarField from '../../../components/clients/lumen/art/StarField.astro';
import NightRibbon from '../../../components/clients/lumen/art/NightRibbon.astro';
const chart = [
  ['4–5 months', '3–4', '1¾–2¼ h', '5:15–5:45 pm'],
  ['6–8 months', '2–3', '2¼–3 h', '5:45–6:30 pm'],
  ['9–12 months', '2', '3–3¾ h', '6:30–7:15 pm'],
  ['13–18 months', '1–2', '3½–4½ h', '7:00–8:00 pm'],
  ['19 months – 3 years', '1', '4½–6 h', '8:00–9:30 pm (aim early)'],
];
const script = [
  ['0–2', 'Lights low, curtains closed, white noise on.', '“It’s sleepy time.”'],
  ['2–5', 'Nappy, pyjamas, sleep sack. Slow hands, quiet voice.', 'Name what you’re doing. “Arms in. Zip up.”'],
  ['5–8', 'One book or one song. The same one.', 'The same book or song every night. Boring is the point.'],
  ['8–9', 'Cuddle, then into the cot awake or drowsy.', '“I love you. Night night. I’m right here.”'],
  ['9–10', 'Hand on chest or back for a count of 20, then step back.', 'Nothing. Let the room be quiet.'],
];
const nights = [
  { title: 'Dial the window', body: 'Bedtime from the chart. Run the script. Into the cot awake or drowsy. Expect 5–15 minutes of protest; stay in the room.' },
  { title: 'Same again', body: 'Exactly last night, same words. Less protest. Add nothing new; consistency is the lesson.' },
  { title: 'The 2 a.m. plan', body: 'Use page 10 for every waking, exactly as written. Most families get the first 6-hour stretch tonight.' },
  { title: 'Hold the line', body: 'The night parents want to quit. Change nothing. A slightly worse night four is normal.' },
  { title: 'Naps join the plan', body: 'Use the chart for naps: short end of the window, lights low, mini-script (steps 1, 4, 5).' },
  { title: 'The long stretch', body: 'For most babies, this is the night. Don’t celebrate; repeat it.' },
  { title: 'Lock it in', body: 'Compare night one and night seven in your log. Then read page 12.' },
];
---
<!doctype html>
<html lang="en" data-client="lumen">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>The 7-Night Bedtime Reset</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" />
    <style>
      @page { size: A4; margin: 0; }
      .page { width: 210mm; min-height: 297mm; padding: 18mm 18mm 20mm; box-sizing: border-box; page-break-after: always; position: relative; }
      .page:last-child { page-break-after: auto; }
      @media screen { body { background: var(--color-surface-2); } .page { margin: 16px auto; background: var(--color-bg); box-shadow: 0 10px 40px rgb(0 0 0 / 0.15); } .page.night { background: var(--color-inverse); } }
      @media print { .page { background: var(--color-bg); } .page.night { background: var(--color-inverse); -webkit-print-color-adjust: exact; print-color-adjust: exact; } * { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
      .folio { position: absolute; bottom: 10mm; left: 18mm; right: 18mm; display: flex; justify-content: space-between; font-size: 10px; color: var(--color-fg-subtle); }
      table { border-collapse: collapse; width: 100%; font-size: 13.5px; } th, td { text-align: left; padding: 9px 10px; border-bottom: 1px solid var(--color-border); vertical-align: top; } th { font-weight: 800; color: var(--color-fg); }
      .lead { font-size: 15.5px; line-height: 1.55; } p:not([class*="mt-"]) { margin: 0 0 10px; }
    </style>
  </head>
  <body class="text-[14px] leading-[1.55] text-fg">

    <!-- Cover -->
    <section class="page night relative overflow-hidden text-inverse-fg">
      <StarField count={80} seed={11} />
      <div class="relative flex h-full min-h-[257mm] flex-col justify-between">
        <p class="font-bold text-accent-2">Lumen Sleep · free guide</p>
        <div>
          <div class="mb-8"><Moon size={120} phase={0.8} /></div>
          <h1 class="font-display text-[56px] font-semibold leading-[1.0]">The 7-Night<br />Bedtime Reset</h1>
          <p class="mt-6 max-w-[40ch] text-[18px] text-inverse-fg/85">The free plan for babies and toddlers (4 months to 3 years) who fight sleep. The chart, the 10-minute script, and seven nights, night by night. No cry-it-out.</p>
        </div>
        <p class="text-sm text-inverse-fg/70">By Maya Lindqvist, certified pediatric sleep consultant · lumensleep.example.com</p>
      </div>
    </section>

    <!-- 1 -->
    <section class="page">
      <p class="font-bold text-primary">Page 1 · Read this first (2 minutes)</p>
      <h2 class="mt-2 font-display text-[34px] font-semibold leading-[1.05]">Your baby isn’t a bad sleeper. She’s probably forty minutes overtired.</h2>
      <div class="lead mt-6">
        <p>That’s the whole guide in one sentence, so if you only read one page, read this one.</p>
        <p>Every baby has a <strong>wake window</strong>: the amount of awake time her body can handle before stress hormones switch on to keep her going. Miss the window and cortisol floods in. Now she’s wired. Bedtime takes an hour. And because cortisol hangs around, she pops awake at 2 a.m. ready to party.</p>
        <p>The fix is the opposite of what feels logical: <strong>earlier, not later.</strong> Get the timing right and most of the fighting disappears. Get it right for seven nights in a row and the 2 a.m. waking usually goes with it.</p>
        <p>This Reset gives you three things: the chart that tells you tonight’s bedtime (page 3), a ten-minute bedtime script (page 5), and seven nights, night by night (pages 6–9). There’s a page for 2 a.m. (page 10), the five mistakes (page 11), and what to do on night eight (page 12).</p>
      </div>
      <div class="mt-6 rounded-lg border-2 border-accent bg-surface p-5">
        <p class="font-display text-lg font-semibold">One rule for the week</p>
        <p class="mb-0">Nobody cries it out. You stay with your baby. The plan changes timing and routine, nothing else. Feeding, medical care and safe-sleep guidance stay exactly as your pediatrician has them.</p>
      </div>
      <div class="folio"><span>The 7-Night Bedtime Reset</span><span>1</span></div>
    </section>

    <!-- 2 -->
    <section class="page">
      <p class="font-bold text-primary">Page 2 · How to use this guide</p>
      <ol class="lead mt-4 list-decimal space-y-3 pl-6">
        <li>Print page 3 and stick it on the fridge.</li>
        <li>Tonight, set bedtime from the chart, not from habit. It will feel early. Do it anyway.</li>
        <li>Run the script on page 5. Same ten minutes, every night, in the same order.</li>
        <li>Read tonight’s page before bedtime, not during. Each night takes two minutes to read.</li>
        <li>Keep a log (page 13). One line a night: bedtime, asleep time, each waking. You’ll want it on night seven.</li>
      </ol>
      <div class="mt-8 grid grid-cols-2 gap-5">
        <div class="rounded-lg bg-surface-2 p-5"><p class="font-display text-lg font-semibold">Who this is for</p><p class="mb-0">Babies and toddlers from 4 months to 3 years. Under 4 months, newborn sleep is different; email hello@lumensleep.example.com.</p></div>
        <div class="rounded-lg bg-surface-2 p-5"><p class="font-display text-lg font-semibold">Check with a doctor first</p><p class="mb-0">Any baby with a medical condition affecting breathing, feeding or growth, and any baby whose pediatrician has flagged a sleep concern.</p></div>
      </div>
      <div class="folio"><span>The 7-Night Bedtime Reset</span><span>2</span></div>
    </section>

    <!-- 3 chart -->
    <section class="page">
      <p class="font-bold text-primary">Page 3 · The wake-window chart (print this)</p>
      <h2 class="mt-2 font-display text-[30px] font-semibold leading-[1.05]">Wake window = time from the end of the last nap to lights out.</h2>
      <table class="mt-6">
        <thead><tr><th>Age</th><th>Naps a day</th><th>Wake window before bed</th><th>Last nap ended 3:30 → lights out</th></tr></thead>
        <tbody>{chart.map((r) => <tr>{r.map((c, i) => <td class:list={[i === 0 && 'font-bold', i === 2 && 'font-display text-lg text-primary']}>{c}</td>)}</tr>)}</tbody>
      </table>
      <div class="lead mt-6">
        <p><strong>How to read it:</strong> find her age, add the window to the time her last nap ended, and aim for the <strong>middle</strong> of the range tonight. If she shows tired signs (rubbing eyes, staring, going quiet) before that, go earlier. If she gets giggly and wild, you’ve already missed it: go now.</p>
      </div>
      <div class="mt-5 rounded-lg bg-inverse p-5 text-inverse-fg">
        <p class="font-display text-lg font-semibold">Tonight’s bedtime</p>
        <p class="mb-0">Last nap ended at ______ &nbsp;+&nbsp; window ______ &nbsp;=&nbsp; lights out at ______</p>
      </div>
      <p class="mt-5 text-xs text-fg-subtle">Ranges are mainstream pediatric wake-window guidance for healthy babies; every baby sits somewhere inside her range.</p>
      <div class="folio"><span>The 7-Night Bedtime Reset</span><span>3</span></div>
    </section>

    <!-- 4 mechanism -->
    <section class="page">
      <p class="font-bold text-primary">Page 4 · Why earlier works</p>
      <h2 class="mt-2 font-display text-[30px] font-semibold leading-[1.05]">Cortisol is a second wind with a cost.</h2>
      <div class="lead mt-6">
        <p>When your baby stays awake past her window, her body releases it so she can keep going. It works. She looks fine, even energetic. That’s the 7 p.m. giggles.</p>
        <p>Then you try to put her down. Her body is still running on the second wind, so she fights. When she finally crashes, cortisol doesn’t switch off. It fades slowly. Between sleep cycles, usually around 2 a.m., it’s still high enough to wake her properly.</p>
        <p>Move bedtime earlier, before the second wind, and three things happen over a few nights:</p>
        <ul class="list-disc space-y-2 pl-6">
          <li>bedtime gets shorter, because she’s tired instead of wired;</li>
          <li>the first stretch gets longer, because she went down calm;</li>
          <li>the 2 a.m. waking fades, because there’s less cortisol to do the waking.</li>
        </ul>
        <p class="mt-4">Naps are the same mechanism in daylight. A 30-minute nap is usually a baby who went down overtired and couldn’t link her sleep cycles.</p>
      </div>
      <div class="folio"><span>The 7-Night Bedtime Reset</span><span>4</span></div>
    </section>

    <!-- 5 script -->
    <section class="page">
      <p class="font-bold text-primary">Page 5 · The 10-minute bedtime script</p>
      <h2 class="mt-2 font-display text-[30px] font-semibold leading-[1.05]">Same ten minutes, same order, every night.</h2>
      <p class="lead mt-3">Her brain learns the sequence; by night three she’ll start to settle at step two.</p>
      <table class="mt-5">
        <thead><tr><th>Minute</th><th>Step</th><th>Say</th></tr></thead>
        <tbody>{script.map((r) => <tr><td class="font-display text-lg text-primary">{r[0]}</td><td>{r[1]}</td><td class="text-fg-muted">{r[2]}</td></tr>)}</tbody>
      </table>
      <div class="mt-6 rounded-lg bg-surface-2 p-5">
        <p class="font-display text-lg font-semibold">Three rules</p>
        <p class="mb-0">No screens in the last hour. The last feed happens <strong>before</strong> the script, not as the last step. Once lights are out, you don’t turn them back on.</p>
      </div>
      <div class="folio"><span>The 7-Night Bedtime Reset</span><span>5</span></div>
    </section>

    <!-- 6–9 nights -->
    <section class="page">
      <p class="font-bold text-primary">Pages 6–9 · Seven nights, night by night</p>
      <h2 class="mt-2 font-display text-[30px] font-semibold leading-[1.05]">Read tonight’s night before bedtime. Two minutes each.</h2>
      <NightRibbon nights={nights} class="mt-8 !grid-cols-1 gap-5 sm:!grid-cols-2" />
      <div class="mt-6 rounded-lg border-2 border-dashed border-border-strong p-4 text-sm"><strong>Every night’s log line:</strong> bedtime ____ · asleep ____ · wakings ____ · longest stretch ____</div>
      <div class="folio"><span>The 7-Night Bedtime Reset</span><span>6–9</span></div>
    </section>

    <!-- 10 decision tree -->
    <section class="page">
      <p class="font-bold text-primary">Page 10 · The 2 a.m. decision tree</p>
      <h2 class="mt-2 font-display text-[30px] font-semibold leading-[1.05]">She wakes. Before you move, ask in order.</h2>
      <ol class="lead mt-6 space-y-4">
        {[
          ['Has it been under 10 minutes since she fell asleep?', 'Wait 3 minutes. Most babies resettle between cycles.'],
          ['Is she crying, or grizzling?', 'Grizzling: wait 3 minutes, then go in. Crying: go in now.'],
          ['In the room', 'Lights off, voice low, hand on chest. “I’m here. It’s sleepy time.” Stay until she’s calm. Pick her up only if she’s distressed; put her down as soon as she’s calm.'],
          ['Is it a feed window (your pediatrician’s guidance for her age)?', 'Feed with lights off, no talking, back in the cot awake or drowsy.'],
          ['Is she standing?', 'Lay her down once, hand on back, same words. Don’t make it a game.'],
          ['Repeat.', 'Same words, same calm, as many times as it takes. You never leave her to cry.'],
        ].map(([q, a], i) => <li class="flex gap-4"><span class="grid size-8 shrink-0 place-items-center rounded-pill bg-inverse font-bold text-inverse-fg">{i + 1}</span><span><strong>{q}</strong> {a}</span></li>)}
      </ol>
      <p class="mt-6 rounded-lg bg-accent/30 p-4 font-bold">What this is not: it is not letting her cry it out. You are there for every minute.</p>
      <div class="folio"><span>The 7-Night Bedtime Reset</span><span>10</span></div>
    </section>

    <!-- 11 mistakes -->
    <section class="page">
      <p class="font-bold text-primary">Page 11 · The five mistakes that cause early wakings</p>
      <ol class="lead mt-6 list-decimal space-y-4 pl-6">
        <li><strong>Later bedtime to make her “more tired.”</strong> The most common one. More cortisol, worse night, earlier morning.</li>
        <li><strong>Different routine on different nights.</strong> Babies learn from repetition. Pick one script and keep it for seven nights.</li>
        <li><strong>Feeding as the last step.</strong> Feed before the script so sleep isn’t tied to the bottle or breast.</li>
        <li><strong>Lights on at 2 a.m.</strong> Light tells her brain it’s morning. Keep the room dark for every waking.</li>
        <li><strong>Fixing nights but not naps.</strong> Short, late naps push bedtime past the window. From night five, use the chart for naps.</li>
      </ol>
      <div class="folio"><span>The 7-Night Bedtime Reset</span><span>11</span></div>
    </section>

    <!-- 12 next -->
    <section class="page">
      <p class="font-bold text-primary">Page 12 · Night eight, and what comes next</p>
      <div class="lead mt-4">
        <p>If you ran seven nights, compare your log. Most families see a longer first stretch by night two, fewer wakings by night four, and the long stretch on night six or seven. If you’re there, keep going exactly as you are for another week. It locks in.</p>
        <p>If your nights still have a “but” in them (reflux, twins, daycare naps you can’t control, a sibling in the room, a trip next month), the Reset is doing what a free guide can do. Two next steps:</p>
      </div>
      <div class="mt-6 grid grid-cols-2 gap-5">
        <div class="rounded-lg bg-surface-2 p-5"><p class="font-display text-lg font-semibold">Free 20-minute Sleep Clarity Call</p><p>Tell Maya your nights and leave with a plan for your baby.</p><p class="mb-0 font-bold text-primary">lumensleep.example.com/lumen/calendar</p></div>
        <div class="rounded-lg bg-inverse p-5 text-inverse-fg"><p class="font-display text-lg font-semibold">The Lumen Sleep Method</p><p>The seven nights as video for your baby’s exact age, the full nap plan, the full 2 a.m. plan, the community and a live Q&A with Maya every week. With the Sleep-Through Guarantee.</p><p class="mb-0 font-bold text-accent">lumensleep.example.com/lumen/checkout</p></div>
      </div>
      <div class="folio"><span>The 7-Night Bedtime Reset</span><span>12</span></div>
    </section>

    <!-- 13 log -->
    <section class="page">
      <p class="font-bold text-primary">Page 13 · Your 7-night log</p>
      <table class="mt-5"><thead><tr><th>Night</th><th>Bedtime</th><th>Asleep by</th><th>Wakings (time, what you did)</th><th>Longest stretch</th></tr></thead>
        <tbody>{[1, 2, 3, 4, 5, 6, 7].map((n) => <tr class="h-[22mm]"><td class="font-display text-lg text-primary">{n}</td><td></td><td></td><td></td><td></td></tr>)}</tbody></table>
      <div class="folio"><span>The 7-Night Bedtime Reset</span><span>13</span></div>
    </section>

    <!-- 14 fine print -->
    <section class="page">
      <p class="font-bold text-primary">Page 14 · The fine print</p>
      <div class="mt-4 text-fg-muted">
        <p>This guide is general information about sleep timing and routine for healthy babies and toddlers. It is not medical advice and doesn’t replace your pediatrician. Follow current safe-sleep guidance for your country. If you’re worried about your baby’s breathing, feeding, growth or development, see a doctor first.</p>
        <p>© Lumen Sleep Co. You may print this for your own family. Please don’t resell it; send people to lumensleep.example.com/lumen/ebook instead, it’s free there too.</p>
      </div>
      <div class="mt-16 flex items-center gap-4"><Moon size={48} phase={1} /><p class="mb-0 font-display text-xl font-semibold">See you on night two.</p></div>
      <div class="folio"><span>The 7-Night Bedtime Reset</span><span>14</span></div>
    </section>
  </body>
