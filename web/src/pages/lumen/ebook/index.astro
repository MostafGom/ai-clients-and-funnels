---
/* Lumen · ebook opt-in. Copy: clients/lumen/funnels/ebook/COPY.md */
import Layout from '../../../layouts/FunnelLayout.astro';
import Container from '../../../components/ui/Container.astro';
import OptInForm from '../../../components/funnel/OptInForm.astro';
import NightBand from '../../../components/clients/lumen/NightBand.astro';
import FaqList from '../../../components/clients/lumen/FaqList.astro';
import ClaimFlag from '../../../components/clients/lumen/ClaimFlag.astro';
import WakeWindowDial from '../../../components/clients/lumen/art/WakeWindowDial.astro';
import Moon from '../../../components/clients/lumen/art/Moon.astro';
import PortraitSlot from '../../../components/clients/lumen/art/PortraitSlot.astro';
const spreads = [
  { n: 'Page 3', title: 'The wake-window chart, by age', body: '4 months to 3 years, printable, for the fridge. The one number that decides tonight.' },
  { n: 'Page 5', title: 'The 10-minute bedtime script', body: 'Same ten minutes every night. Her brain learns it by night three.' },
  { n: 'Pages 6–9', title: 'Seven nights, night by night', body: 'What to do, what to expect, and the night most parents want to quit (it’s four).' },
  { n: 'Page 10', title: 'The 2 a.m. decision tree', body: 'Go in or wait? Feed or don’t? One page, no guessing in the dark.' },
];
---
<Layout client="lumen" funnel="ebook" step="optin" title="What time should your baby go to bed tonight? Free 7-Night Bedtime Reset" description="Pick your baby's age and last nap, get tonight's bedtime, then download the free 7-Night Bedtime Reset: the wake-window chart, the 10-minute script, and the night-by-night plan. No cry-it-out.">

  <NightBand edge="cloud" pad="lg" stars={100} seed={3} class="overflow-hidden">
    <Container size="wide">
      <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,560px)]">
        <div>
          <p class="text-base font-bold text-accent-2">Free guide for parents of 4-month to 3-year-olds. No cry-it-out.</p>
          <h1 class="mt-5 text-display font-semibold">What time should your baby<br class="hidden lg:block" /> go to bed tonight?</h1>
          <p class="mt-7 max-w-[58ch] text-lead text-inverse-fg/85">Pick her age and when her last nap ended. That’s tonight’s bedtime. Then get the free <strong class="text-inverse-fg">7-Night Bedtime Reset</strong>: the chart, the 10-minute script, and the night-by-night plan 2,300+ families<ClaimFlag /> used to end the 2 a.m. party.</p>
          <div class="mt-8 hidden lg:block"><Moon size={140} phase={0.8} /></div>
        </div>
        <div class="text-fg">
          <WakeWindowDial heading="Tonight’s bedtime">
            <p class="text-sm text-fg-muted">Most parents are 30 to 60 minutes late. That’s the whole problem, and the Reset fixes it in seven nights.</p>
            <OptInForm client="lumen" funnel="ebook" redirect="/lumen/ebook/thanks" magnet="bedtime-reset" buttonLabel="Send me the 7-night plan" consent="One guide, five short emails from Maya, unsubscribe in one tap." class="mt-5 max-w-none" />
          </WakeWindowDial>
        </div>
      </div>
    </Container>
  </NightBand>

  <section class="bg-bg py-16 sm:py-24">
    <Container>
      <div class="max-w-[62ch]"><h2 class="text-h1 font-semibold">Twelve minutes to read.<br />Seven nights to run.</h2></div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {spreads.map((s) => (
          <div class="flex gap-5 rounded-xl bg-surface p-6 shadow-card">
            <div class="flex h-24 w-[68px] shrink-0 flex-col justify-between rounded-md bg-inverse p-2 text-[9px] font-bold text-inverse-fg/80"><span>{s.n}</span><span class="h-1.5 w-8 rounded-pill bg-accent"></span></div>
            <div><p class="font-display text-xl font-semibold">{s.title}</p><p class="mt-1 text-fg-muted">{s.body}</p></div>
          </div>
        ))}
      </div>
      <p class="mt-6 text-fg-muted">Plus: the five mistakes that cause early wakings, your 7-night log, and what to do on night eight.</p>
    </Container>
  </section>

  <section class="bg-surface-2 py-16 sm:py-20">
    <Container>
      <div class="grid items-center gap-10 md:grid-cols-[auto_1fr]">
        <PortraitSlot name="Maya" caption="Maya Lindqvist, certified pediatric sleep consultant" size={200} />
        <div class="max-w-[62ch]">
          <h2 class="text-h2 font-semibold">Written by someone who did the hallway shuffle for eleven months.</h2>
          <p class="mt-5 text-lg">I’m Maya Lindqvist, a certified pediatric sleep consultant<ClaimFlag />. Before that I was a mum with an 11-month-old who woke seven times a night and a spreadsheet that didn’t help. What fixed it was timing. Since 2019 I’ve helped 2,300+ families<ClaimFlag /> fix theirs, and the Reset is the first thing I give every one of them.</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-bg py-16 sm:py-20">
    <Container>
      <div class="grid gap-6 md:grid-cols-3">
        {[
          { q: 'Printed the chart, moved bedtime 50 minutes earlier, she slept six hours. Night one.', who: 'Hannah L., 8-month-old' },
          { q: 'The script is genius. Same ten minutes, and by night three he knew what was coming.', who: 'Tom & Grace, 19-month-old' },
          { q: 'I read it at 3 a.m. and cried, because it finally made sense.', who: 'Sofia B., 7-month-old' },
        ].map((t) => <figure class="rounded-xl border-l-4 border-accent bg-surface p-6 shadow-card"><blockquote class="text-lg">“{t.q}”</blockquote><figcaption class="mt-4 text-sm text-fg-muted">{t.who}<ClaimFlag /></figcaption></figure>)}
      </div>
      <FaqList class="mt-14" items={[
        { q: 'Is there any crying it out?', a: 'No. The Reset is timing and a script. The 2 a.m. page tells you what to do when she wakes, and “leave her to cry” is never the answer.' },
        { q: 'My baby is 5 months, or 2½ years. Does it apply?', a: 'The chart runs from 4 months to 3 years with a row for each stage. Under 4 months, email us.' },
        { q: 'What happens after I enter my email?', a: 'The Reset lands in your inbox in about a minute. Then five short emails from Maya over the next week: one idea each, no fluff. Unsubscribe in one tap.' },
      ]} />
    </Container>
  </section>

  <NightBand edgeTop="cloud" edge="none" seed={33} pad="lg">
    <Container size="prose" class="text-center">
      <h2 class="text-display font-semibold">Tonight could be night one.</h2>
      <p class="mt-5 text-lead text-inverse-fg/85">Free PDF. Twelve-minute read. The chart, the script, the plan.</p>
      <div class="mt-8 flex justify-center [&_span]:text-inverse-fg [&_p]:text-inverse-fg/70">
        <OptInForm client="lumen" funnel="ebook" redirect="/lumen/ebook/thanks" magnet="bedtime-reset" buttonLabel="Send me the 7-night plan" consent="One guide, five short emails, unsubscribe in one tap." inline />
      </div>
    </Container>
  </NightBand>

  <script>
    // Carry the baby's age from the dial into the lead so the delivery email can personalise.
    const sel = document.querySelector<HTMLSelectElement>('[data-dial] select[name=age]');
    const sync = () => document.querySelectorAll<HTMLFormElement>('form[data-optin]').forEach((f) => {
      let i = f.querySelector<HTMLInputElement>('input[name=age]');
      if (!i) { i = document.createElement('input'); i.type = 'hidden'; i.name = 'age'; f.append(i); }
      i.value = sel?.value ?? '';
    });
    sel?.addEventListener('change', sync); sync();
  </script>
</Layout>
