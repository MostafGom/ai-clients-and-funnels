---
interface Props { tone?: 'primary' | 'accent' | 'muted' | 'success' | 'accent-2'; class?: string }
const { tone = 'primary', class: cls = '' } = Astro.props;
const tones = {
  primary: 'bg-primary-soft text-primary',
  accent: 'bg-accent text-accent-fg',
  'accent-2': 'bg-accent-2 text-accent-2-fg',
  muted: 'bg-surface-2 text-fg-muted',
  success: 'bg-surface-2 text-success',
};
---
<span class:list={['inline-flex items-center gap-1.5 rounded-pill px-3.5 py-1 text-sm font-bold', tones[tone], cls]}><slot /></span>
