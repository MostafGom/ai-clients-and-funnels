---
interface Props { size?: 'prose' | 'content' | 'wide'; class?: string }
const { size = 'content', class: cls = '' } = Astro.props;
const max = { prose: 'max-w-prose', content: 'max-w-content', wide: 'max-w-wide' }[size];
---
<div class:list={['mx-auto w-full px-5 sm:px-8', max, cls]}><slot /></div>
