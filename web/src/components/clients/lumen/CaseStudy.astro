---
/** One family: situation → what changed → the log → the quote. Lives on the night band. */
import NightLog from './art/NightLog.astro';
import MonitorFrame from './art/MonitorFrame.astro';
interface Props { name: string; who: string; hook: string; before: string; change: string; after: string[]; beforeHours: number[]; quote: string; monitor: { hours: string; night: string }; flag?: string }
const { name, who, hook, before, change, after, beforeHours, quote, monitor, flag } = Astro.props;
---
<article class="grid gap-8 rounded-xl bg-inverse-2 p-6 shadow-pop sm:p-8 lg:grid-cols-[1.1fr_0.9fr]">
  <div>
    <p class="font-display text-2xl font-semibold">{name} <span class="text-accent-2">· {who}</span></p>
    <p class="mt-1 text-lg">“{hook}”</p>
    <dl class="mt-6 space-y-4 text-inverse-fg/90">
      <div><dt class="text-sm font-bold text-accent-2">Before</dt><dd>{before}</dd></div>
      <div><dt class="text-sm font-bold text-accent-2">What changed</dt><dd>{change}</dd></div>
    </dl>
    <blockquote class="mt-6 border-l-4 border-accent pl-4 text-lg">“{quote}”</blockquote>
    {flag && <p class="mt-4 inline-block rounded-md border border-dashed border-accent/60 px-2 py-1 text-xs text-accent">{flag}</p>}
  </div>
  <div class="flex flex-col gap-6">
    <NightLog before={beforeHours} after={after.map(Number)} />
    <div class="self-center lg:self-end"><MonitorFrame hours={monitor.hours} night={monitor.night} /></div>
  </div>
</article>
