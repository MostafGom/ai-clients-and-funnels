---
/** The moon. phase 0 = new (thin crescent), 1 = full. `rise` plays the once-on-load rise. */
interface Props { size?: number; phase?: number; rise?: boolean; class?: string }
const { size = 160, phase = 0.72, rise = false, class: cls = '' } = Astro.props;
const shadowX = 50 - (1 - phase) * 62; // move the shadow disc to carve the crescent
---
<svg aria-hidden="true" width={size} height={size} viewBox="0 0 100 100" class:list={[rise && 'moon-rise', cls]}>
  <defs>
    <mask id={`moon-mask-${phase}`}>
      <rect width="100" height="100" fill="white" />
      <circle cx={shadowX} cy="46" r="44" fill="black" />
    </mask>
  </defs>
  <circle cx="50" cy="50" r="44" fill="var(--color-accent)" mask={phase >= 0.98 ? undefined : `url(#moon-mask-${phase})`} />
  <circle cx="38" cy="40" r="5" fill="var(--color-accent-fg)" opacity="0.12" />
  <circle cx="58" cy="62" r="7" fill="var(--color-accent-fg)" opacity="0.1" />
  <circle cx="64" cy="36" r="3" fill="var(--color-accent-fg)" opacity="0.1" />
</svg>
<style>
  .moon-rise { animation: moon-rise 1.2s var(--ease-out-expo) both; }
  @keyframes moon-rise { from { transform: translateY(28px); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .moon-rise { animation: none; } }
</style>
