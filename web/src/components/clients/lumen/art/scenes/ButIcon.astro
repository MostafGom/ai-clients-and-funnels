---
/** Icons for the four "buts": twins, reflux, daycare, sibling, travel. Line style in the client palette. */
interface Props { kind: 'twins' | 'reflux' | 'daycare' | 'sibling' | 'travel'; size?: number; class?: string }
const { kind, size = 48, class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 48 48" width={size} height={size} class={cls} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
  {kind === 'twins' && <><circle cx="16" cy="16" r="6" /><circle cx="32" cy="16" r="6" /><path d="M8 40c0-7 3-12 8-12s8 5 8 12M24 40c0-7 3-12 8-12s8 5 8 12" /></>}
  {kind === 'reflux' && <><path d="M16 10h16l-2 14a6 6 0 0 1-12 0z" /><path d="M24 4v6" /><path d="M14 38c4-3 6-3 10 0s6 3 10 0" /></>}
  {kind === 'daycare' && <><path d="M6 22 24 8l18 14" /><path d="M10 20v20h28V20" /><rect x="20" y="28" width="8" height="12" /><circle cx="36" cy="12" r="3" fill="currentColor" stroke="none" /></>}
  {kind === 'sibling' && <><circle cx="15" cy="14" r="6" /><circle cx="33" cy="20" r="4.5" /><path d="M6 40c0-9 4-14 9-14s9 5 9 14M26 40c0-6 3-10 7-10s7 4 7 10" /></>}
  {kind === 'travel' && <><path d="M8 32h32l-4-12H12z" /><path d="M18 20v-6h12v6" /><path d="M8 32v6h32v-6" /><path d="M40 10l-6-6" /></>}
</svg>
