---
/** 8 p.m., seven nights later. Parent on the sofa, monitor quiet, tea. The future-pace scene. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 640 400" class={cls} role="img" aria-label="Illustration: a parent relaxed on a sofa at 8 p.m. with a quiet baby monitor and a cup of tea">
  <defs><radialGradient id="sofa-glow" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="var(--color-accent)" stop-opacity=".28" /><stop offset="1" stop-color="var(--color-accent)" stop-opacity="0" /></radialGradient></defs>
  <rect width="640" height="400" rx="28" fill="var(--color-inverse)" />
  <!-- lamp glow -->
  <circle cx="520" cy="130" r="170" fill="url(#sofa-glow)" />
  <rect x="508" y="150" width="24" height="150" rx="6" fill="var(--color-inverse-2)" />
  <path d="M470 150 L570 150 L548 92 L492 92Z" fill="var(--color-accent)" opacity=".9" />
  <!-- window -->
  <rect x="48" y="44" width="150" height="120" rx="14" fill="#1f1740" />
  <circle cx="150" cy="84" r="20" fill="var(--color-accent)" />
  <circle cx="76" cy="70" r="2" fill="#fff7ec" opacity=".8" /><circle cx="104" cy="130" r="1.5" fill="#fff7ec" opacity=".6" />
  <!-- clock -->
  <text x="48" y="196" font-family="Fredoka, Nunito, sans-serif" font-weight="700" font-size="26" fill="var(--color-accent-2)">8:02 pm</text>
  <!-- sofa -->
  <rect x="100" y="230" width="420" height="120" rx="28" fill="#6b5aa0" />
  <rect x="80" y="250" width="50" height="110" rx="18" fill="#7c6bb0" /><rect x="490" y="250" width="50" height="110" rx="18" fill="#7c6bb0" />
  <rect x="120" y="212" width="380" height="50" rx="20" fill="#7c6bb0" />
  <!-- parent, relaxed -->
  <g transform="translate(290 150)">
    <path d="M-48 150 C-52 96 -30 72 0 72 C30 72 52 96 48 150Z" fill="#5c527a" />
    <path d="M-30 60 C-30 22 -10 6 0 6 C10 6 30 22 30 60 L22 90 L-22 90Z" fill="#4a2e1f" />
    <ellipse cx="0" cy="62" rx="26" ry="30" fill="#f1c6a3" />
    <path d="M-26 54 C-24 34 -14 24 0 24 C14 24 24 34 26 54 C20 44 10 40 0 40 C-10 40 -20 44 -26 54Z" fill="#4a2e1f" />
    <circle cx="4" cy="12" r="13" fill="#4a2e1f" />
    <!-- eyes open, calm; real smile -->
    <circle cx="-9" cy="64" r="2.6" fill="#3a2a22" /><circle cx="9" cy="64" r="2.6" fill="#3a2a22" />
    <path d="M-10 78 q10 9 20 0" stroke="#b3503a" stroke-width="2.6" fill="none" stroke-linecap="round" />
    <circle cx="-16" cy="72" r="4" fill="#e7a28a" opacity=".5" /><circle cx="16" cy="72" r="4" fill="#e7a28a" opacity=".5" />
    <!-- arm + mug -->
    <path d="M30 110 C56 100 76 110 80 126" stroke="#5c527a" stroke-width="16" fill="none" stroke-linecap="round" />
    <rect x="70" y="112" width="30" height="30" rx="6" fill="var(--color-bg)" /><path d="M100 120 a8 8 0 0 1 0 16" stroke="var(--color-bg)" stroke-width="5" fill="none" />
    <path d="M78 106 q4 -8 0 -14 M88 106 q4 -8 0 -14" stroke="var(--color-inverse-fg)" stroke-width="2" fill="none" opacity=".5" stroke-linecap="round" />
  </g>
  <!-- monitor on the arm of the sofa -->
  <g transform="translate(436 176)">
    <rect x="0" y="0" width="54" height="64" rx="12" fill="var(--color-inverse-fg)" />
    <rect x="6" y="6" width="42" height="44" rx="8" fill="var(--color-inverse)" />
    <circle cx="27" cy="28" r="9" fill="var(--color-success)" opacity=".9" />
    <text x="27" y="60" text-anchor="middle" font-family="Nunito, sans-serif" font-size="8" font-weight="800" fill="var(--color-inverse)">asleep</text>
  </g>
  <text x="596" y="384" text-anchor="end" font-family="Nunito, sans-serif" font-size="13" fill="var(--color-accent-2)" opacity=".8">night 7</text>
</svg>
