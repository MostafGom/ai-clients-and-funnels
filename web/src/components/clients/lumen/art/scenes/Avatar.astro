---
/**
 * Illustrated parent avatars for testimonials. Deterministic from `who` so the same family always looks the same.
 * Never a photo of a real person; visibly an illustration.
 */
interface Props { who: string; size?: number; class?: string; twins?: boolean }
const { who, size = 72, class: cls = '', twins = false } = Astro.props;
let h = 0; for (const c of who) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const skins = ['#f1c6a3', '#d9a27c', '#b47a52', '#8d5a3b', '#f4d7bd', '#6b4026'];
const hairs = ['#4a2e1f', '#1f1a1a', '#8a5a2b', '#2f2f2f', '#5a3b2e'];
const tops = ['var(--color-primary)', 'var(--color-success)', 'var(--color-accent-2)', '#6b5aa0', 'var(--color-accent)'];
const skin = skins[h % skins.length], hair = hairs[(h >> 3) % hairs.length], top = tops[(h >> 6) % tops.length];
const style = (h >> 9) % 3; // 0 bun, 1 short, 2 long
---
<svg viewBox="0 0 100 100" width={size} height={size} class={cls} aria-hidden="true">
  <circle cx="50" cy="50" r="48" fill="var(--color-surface-2)" />
  <clipPath id={`av-${h}`}><circle cx="50" cy="50" r="48" /></clipPath>
  <g clip-path={`url(#av-${h})`}>
    <path d="M14 104 C14 76 30 66 50 66 C70 66 86 76 86 104Z" fill={top} />
    {style === 2 && <path d="M28 44 C26 22 40 14 50 14 C60 14 74 22 72 44 L74 76 L26 76Z" fill={hair} />}
    <ellipse cx="50" cy="44" rx="18" ry="21" fill={skin} />
    {style === 0 && <><path d="M32 40 C33 26 41 20 50 20 C59 20 67 26 68 40 C62 33 56 31 50 31 C44 31 38 33 32 40Z" fill={hair} /><circle cx="52" cy="17" r="8" fill={hair} /></>}
    {style === 1 && <path d="M31 40 C31 22 40 16 50 16 C60 16 69 22 69 40 C64 32 57 30 50 30 C43 30 36 32 31 40Z" fill={hair} />}
    {style === 2 && <path d="M32 40 C33 26 41 20 50 20 C59 20 67 26 68 40 C62 33 56 31 50 31 C44 31 38 33 32 40Z" fill={hair} />}
    <circle cx="43" cy="44" r="1.8" fill="#3a2a22" /><circle cx="57" cy="44" r="1.8" fill="#3a2a22" />
    <path d="M44 52 q6 5 12 0" stroke="#b3503a" stroke-width="2" fill="none" stroke-linecap="round" />
    <circle cx="39" cy="49" r="2.5" fill="#e7a28a" opacity=".5" /><circle cx="61" cy="49" r="2.5" fill="#e7a28a" opacity=".5" />
    {/* baby on the shoulder (two if twins) */}
    <g transform="translate(70 62)"><rect x="-9" y="-2" width="18" height="24" rx="9" fill="var(--color-accent-2)" /><circle cx="-6" cy="-4" r="7" fill={skin} /><path d="M-11 -7 q5 -6 10 -2" stroke={hair} stroke-width="2.5" fill="none" stroke-linecap="round" /></g>
    {twins && <g transform="translate(28 62)"><rect x="-9" y="-2" width="18" height="24" rx="9" fill="var(--color-accent)" /><circle cx="6" cy="-4" r="7" fill={skin} /><path d="M1 -7 q5 -6 10 -2" stroke={hair} stroke-width="2.5" fill="none" stroke-linecap="round" /></g>}
  </g>
</svg>
