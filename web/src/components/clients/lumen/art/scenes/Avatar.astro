---
/** Round photo avatar for a family named in copy (public/lumen/photos). Falls back to initials. */
import { familyPhoto } from '../../photos';
interface Props { who: string; size?: number; class?: string; twins?: boolean }
const { who, size = 72, class: cls = '' } = Astro.props;
const src = familyPhoto(who);
const initials = who.split(',')[0].split(/\s|&/).filter(Boolean).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
{src
  ? <img src={src} alt="" width={size} height={size} loading="lazy" class:list={['shrink-0 rounded-pill object-cover object-top ring-2 ring-surface', cls]} style={`width:${size}px;height:${size}px`} />
  : <span class:list={['grid shrink-0 place-items-center rounded-pill bg-accent-2 font-display font-semibold text-accent-2-fg', cls]} style={`width:${size}px;height:${size}px;font-size:${size * 0.38}px`} aria-hidden="true">{initials}</span>}
