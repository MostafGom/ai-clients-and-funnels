---
/** 2:14 a.m. A parent in a dark hallway doing the shuffle-bounce, phone glow, the clock. The persona's scene. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 640 400" class={cls} role="img" aria-label="Illustration: a parent rocking a baby in a dark hallway at 2:14 a.m., lit by a phone screen">
  <defs>
    <linearGradient id="hw-glow" cx="0" cy="0" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="var(--color-accent-2)" stop-opacity=".35" /><stop offset="1" stop-color="var(--color-accent-2)" stop-opacity="0" /></linearGradient>
    <radialGradient id="hw-phone" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#cfe6ff" stop-opacity=".55" /><stop offset="1" stop-color="#cfe6ff" stop-opacity="0" /></radialGradient>
  </defs>
  <rect width="640" height="400" rx="28" fill="var(--color-inverse)" />
  <!-- walls / door -->
  <rect x="0" y="0" width="200" height="400" fill="var(--color-inverse-2)" opacity=".6" />
  <rect x="430" y="60" width="120" height="340" rx="6" fill="var(--color-inverse-2)" />
  <rect x="444" y="74" width="92" height="312" rx="4" fill="var(--color-inverse)" opacity=".7" />
  <circle cx="528" cy="236" r="5" fill="var(--color-accent)" opacity=".7" />
  <!-- night light on the floor -->
  <ellipse cx="320" cy="372" rx="240" ry="22" fill="url(#hw-glow)" />
  <!-- clock -->
  <rect x="236" y="40" width="130" height="54" rx="14" fill="var(--color-inverse-2)" />
  <text x="301" y="78" text-anchor="middle" font-family="Fredoka, Nunito, sans-serif" font-weight="700" font-size="34" fill="var(--color-accent)">2:14</text>
  <!-- window moon -->
  <rect x="40" y="48" width="110" height="140" rx="14" fill="#1f1740" />
  <path d="M110 86 a28 28 0 1 0 18 48 a22 22 0 0 1 -18 -48z" fill="var(--color-accent)" />
  <circle cx="64" cy="70" r="2" fill="#fff7ec" opacity=".8" /><circle cx="84" cy="150" r="1.6" fill="#fff7ec" opacity=".6" /><circle cx="128" cy="162" r="1.3" fill="#fff7ec" opacity=".6" />
  <!-- parent: body -->
  <g transform="translate(300 120)">
    <path d="M-62 280 C-62 180 -34 130 0 130 C34 130 62 180 62 280Z" fill="#5c527a" />
    <!-- robe lapels -->
    <path d="M-14 132 L0 190 L14 132 Z" fill="#8a81a3" />
    <!-- head -->
    <path d="M-30 60 C-30 20 -10 4 0 4 C10 4 30 20 30 60 L24 98 L-24 98Z" fill="#4a2e1f" />
    <ellipse cx="0" cy="64" rx="26" ry="31" fill="#f1c6a3" />
    <path d="M-26 56 C-24 36 -14 24 0 24 C14 24 24 36 26 56 C20 46 10 42 0 42 C-10 42 -20 46 -26 56Z" fill="#4a2e1f" />
    <!-- messy bun -->
    <circle cx="6" cy="10" r="14" fill="#4a2e1f" /><path d="M-6 2 q6 -12 14 -4" stroke="#4a2e1f" stroke-width="4" fill="none" stroke-linecap="round" />
    <!-- tired eyes (closed-ish), small smile-grimace -->
    <path d="M-16 68 q6 3 12 0" stroke="#3a2a22" stroke-width="2.6" fill="none" stroke-linecap="round" />
    <path d="M4 68 q6 3 12 0" stroke="#3a2a22" stroke-width="2.6" fill="none" stroke-linecap="round" />
    <path d="M-8 84 q8 4 16 0" stroke="#b3503a" stroke-width="2.4" fill="none" stroke-linecap="round" />
    <!-- arms holding baby -->
    <path d="M-58 190 C-70 160 -44 142 -16 150 L40 160 C62 166 60 196 36 198 L-20 196Z" fill="#5c527a" />
    <!-- baby (sleep sack) over the shoulder -->
    <g transform="translate(-6 128) rotate(-18)">
      <rect x="-26" y="-6" width="52" height="64" rx="24" fill="var(--color-accent-2)" />
      <circle cx="-30" cy="-6" r="18" fill="#f1c6a3" />
      <path d="M-46 -12 C-44 -24 -34 -28 -24 -24 C-20 -20 -18 -16 -16 -12 C-24 -18 -36 -18 -46 -12Z" fill="#4a2e1f" />
      <path d="M-38 -4 q4 2 8 0" stroke="#3a2a22" stroke-width="2" fill="none" stroke-linecap="round" />
      <circle cx="-30" cy="4" r="2.5" fill="#e7a28a" opacity=".7" />
      <text x="-56" y="-28" font-family="Fredoka, sans-serif" font-size="14" fill="var(--color-accent-2)" opacity=".9">z</text>
    </g>
    <!-- phone in the other hand -->
    <rect x="40" y="166" width="28" height="48" rx="6" fill="#1f1740" />
    <rect x="44" y="170" width="20" height="38" rx="3" fill="#cfe6ff" opacity=".9" />
    <circle cx="54" cy="150" r="60" fill="url(#hw-phone)" />
  </g>
  <!-- the 40th tab -->
  <text x="596" y="384" text-anchor="end" font-family="Nunito, sans-serif" font-size="13" fill="var(--color-accent-2)" opacity=".8">tab 40 of 40</text>
</svg>
