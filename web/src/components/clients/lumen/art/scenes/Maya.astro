---
/** Illustrated portrait of Maya (certified pediatric sleep consultant, late 30s, warm, a little tired-wise). Flat, friendly style. */
interface Props { size?: number; class?: string }
const { size = 240, class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 200 200" width={size} height={size} class={cls} role="img" aria-label="Illustration of Maya, pediatric sleep consultant">
  <defs><clipPath id="maya-clip"><circle cx="100" cy="100" r="96" /></clipPath></defs>
  <circle cx="100" cy="100" r="96" fill="var(--color-accent-2)" />
  <g clip-path="url(#maya-clip)">
    <!-- stars -->
    <circle cx="36" cy="40" r="2" fill="var(--color-inverse-fg)" opacity=".8" /><circle cx="160" cy="30" r="1.6" fill="var(--color-inverse-fg)" opacity=".7" /><circle cx="172" cy="78" r="1.3" fill="var(--color-inverse-fg)" opacity=".6" />
    <path d="M150 48 q0 6 6 6 q-6 0 -6 6 q0 -6 -6 -6 q6 0 6 -6z" fill="var(--color-accent)" />
    <!-- body / cardigan -->
    <path d="M30 210 C30 150 60 132 100 132 C140 132 170 150 170 210 Z" fill="var(--color-inverse)" />
    <path d="M86 132 L100 160 L114 132 Z" fill="var(--color-bg)" />
    <path d="M62 210 C62 170 76 150 96 142 L100 160 L104 142 C124 150 138 170 138 210Z" fill="var(--color-inverse-2)" />
    <!-- neck -->
    <path d="M86 112 h28 v26 a14 14 0 0 1 -28 0z" fill="#e9b996" />
    <!-- hair back -->
    <path d="M56 86 C52 46 82 28 100 28 C120 28 148 46 144 88 L140 120 L60 120Z" fill="#4a2e1f" />
    <!-- face -->
    <ellipse cx="100" cy="86" rx="34" ry="40" fill="#f1c6a3" />
    <!-- hair front + bun -->
    <path d="M64 78 C66 52 80 40 100 40 C120 40 134 52 136 78 C128 66 116 60 100 60 C84 60 72 66 64 78Z" fill="#4a2e1f" />
    <circle cx="100" cy="34" r="16" fill="#4a2e1f" /><circle cx="110" cy="27" r="5" fill="var(--color-accent)" />
    <!-- ears -->
    <circle cx="66" cy="90" r="6" fill="#e9b996" /><circle cx="134" cy="90" r="6" fill="#e9b996" />
    <!-- eyes (kind, slightly tired) -->
    <path d="M80 88 q6 -6 12 0" stroke="#3a2a22" stroke-width="3" fill="none" stroke-linecap="round" />
    <path d="M108 88 q6 -6 12 0" stroke="#3a2a22" stroke-width="3" fill="none" stroke-linecap="round" />
    <path d="M78 80 q7 -5 14 -1" stroke="#4a2e1f" stroke-width="2.5" fill="none" stroke-linecap="round" />
    <path d="M108 79 q7 -4 14 1" stroke="#4a2e1f" stroke-width="2.5" fill="none" stroke-linecap="round" />
    <!-- cheeks, nose, smile -->
    <circle cx="80" cy="100" r="5" fill="#e7a28a" opacity=".55" /><circle cx="120" cy="100" r="5" fill="#e7a28a" opacity=".55" />
    <path d="M100 94 q3 6 -1 9" stroke="#d99c7f" stroke-width="2" fill="none" stroke-linecap="round" />
    <path d="M88 108 q12 10 24 0" stroke="#b3503a" stroke-width="3" fill="none" stroke-linecap="round" />
    <!-- earring moon -->
    <path d="M136 100 a5 5 0 1 0 4 8 a4 4 0 0 1 -4 -8z" fill="var(--color-accent)" />
  </g>
</svg>
