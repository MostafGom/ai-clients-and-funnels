---
/** A stylised baby monitor. Illustration, never a fake photo. Shows the night's result. */
interface Props { hours: string; night: string; label?: string; class?: string }
const { hours, night, label = 'longest stretch', class: cls = '' } = Astro.props;
---
<div class:list={['monitor inline-block', cls]} aria-hidden="true">
  <div class="rounded-[1.75rem] bg-inverse-fg p-2.5 shadow-pop">
    <div class="relative overflow-hidden rounded-[1.25rem] bg-inverse px-5 pb-5 pt-4 text-inverse-fg" style="min-width:200px">
      <div class="flex items-center justify-between text-[11px] font-bold opacity-70"><span>{night}</span><span class="inline-flex items-center gap-1"><i class="size-1.5 rounded-pill bg-success"></i>asleep</span></div>
      <p class="mt-3 font-display text-4xl font-semibold">{hours}</p>
      <p class="text-xs opacity-80">{label}</p>
      <div class="mt-3 flex items-end gap-[3px]" style="height:22px">
        {[3, 5, 4, 7, 9, 11, 11].map((h) => <i class="flex-1 rounded-t-sm bg-accent-2" style={`height:${(h / 11) * 100}%`}></i>)}
      </div>
      <svg class="absolute -right-3 -top-3 size-14 opacity-90" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="var(--color-accent)" /><circle cx="22" cy="42" r="40" fill="var(--color-inverse)" /></svg>
    </div>
    <div class="mx-auto mt-2 h-1.5 w-10 rounded-pill bg-inverse/20"></div>
  </div>
</div>
