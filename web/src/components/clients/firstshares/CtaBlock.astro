---
/** The repeated funnel CTA: one button, the friction line, the cohort deadline and the guarantee seal. Centered. */
import Button from '../../ui/Button.astro';
interface Props { href: string; label: string; note?: string; placement: string; tone?: 'paper' | 'inverse'; class?: string }
const { href, label, note = 'One payment · instant access · 30-day guarantee', placement, tone = 'paper', class: cls = '' } = Astro.props;
---
<div class:list={['mx-auto flex max-w-xl flex-col items-center gap-3 text-center', cls]}>
  <Button href={href} size="xl" variant={tone === 'inverse' ? 'accent' : 'primary'} class="w-full whitespace-nowrap px-6 sm:px-9" data-cta={placement}>{label}</Button>
  <p class:list={['text-sm', tone === 'inverse' ? 'opacity-85' : 'text-fg-muted']}>{note}</p>
  <p class:list={['flex items-center gap-2 text-sm font-semibold', tone === 'inverse' ? 'text-accent' : 'text-primary']}>
    <svg viewBox="0 0 20 20" class="size-4" aria-hidden="true"><circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="2" /><path d="M10 5v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    Enroll this month for the live kickoff call + bonus
  </p>
</div>
