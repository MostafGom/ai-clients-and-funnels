---
/** The "whiteboard" band: paper with a faint grid drawn from the border token. For mechanism and maths sections. */
interface Props { id?: string; pad?: 'sm' | 'md' | 'lg'; class?: string }
const { id, pad = 'md', class: cls = '' } = Astro.props;
const pads = { sm: 'py-10 sm:py-14', md: 'py-16 sm:py-24', lg: 'py-24 sm:py-32' };
---
<section id={id} class:list={['graph-paper bg-surface text-fg', pads[pad], cls]}><slot /></section>
<style>
  .graph-paper {
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: -1px -1px;
  }
</style>
