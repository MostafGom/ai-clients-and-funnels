---
/** FAQ built from the persona's objections: heading left, questions right, one open at a time is fine. */
interface Item { q: string; a: string }
interface Props { heading?: string; items: Item[]; class?: string }
const { heading = 'Before you ask', items, class: cls = '' } = Astro.props;
---
<div class:list={['grid gap-10 lg:grid-cols-[1fr_2fr]', cls]}>
  <h2 class="text-h2 font-display font-extrabold">{heading}</h2>
  <div class="divide-y divide-border border-y border-border">
    {items.map((it) => (
      <details class="group py-5">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 font-display text-xl font-bold">
          {it.q}
          <span class="grid size-8 shrink-0 place-items-center rounded-pill bg-primary-soft text-primary transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 max-w-[62ch] text-fg-muted">{it.a}</p>
      </details>
    ))}
  </div>
</div>
