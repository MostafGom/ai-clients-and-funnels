---
/** Proof as actions, never gains: who started, and what they did by which week. Works on paper or inverse bands. */
import { personPhoto } from './photos';
interface Row { who: string; meta: string; steps: { week: string; did: string }[]; q?: string }
interface Props { rows: Row[]; tone?: 'paper' | 'inverse'; class?: string }
const { rows, tone = 'paper', class: cls = '' } = Astro.props;
const card = tone === 'inverse' ? 'bg-inverse-2 text-inverse-fg' : 'bg-surface text-fg shadow-card';
const muted = tone === 'inverse' ? 'opacity-80' : 'text-fg-muted';
---
<ul class:list={['grid gap-5 lg:grid-cols-3', cls]}>
  {rows.map((r) => {
    const src = personPhoto(r.who);
    return (
      <li class:list={['flex flex-col rounded-xl p-6', card]}>
        <div class="flex items-center gap-4">
          {src && <img src={src} alt="" width="64" height="64" loading="lazy" class="size-16 rounded-pill object-cover" />}
          <div><p class="font-display text-xl font-bold">{r.who}</p><p class:list={['text-sm', muted]}>{r.meta}</p></div>
        </div>
        <ol class="mt-5 space-y-0 text-sm">
          {r.steps.map((s) => (
            <li class="flex gap-4 border-t border-dashed border-current/25 py-2.5">
              <span class="w-16 shrink-0 font-semibold tabular-nums">{s.week}</span><span>{s.did}</span>
            </li>
          ))}
        </ol>
        {r.q && <p class="mt-auto pt-5 text-lead font-display font-semibold leading-snug">“{r.q}”</p>}
      </li>
    );
  })}
</ul>
