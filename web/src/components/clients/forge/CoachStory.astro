---
/** Coach story: portrait bleeding off the left edge, credentials as numbers, story in the default slot. */
import { PHOTOS } from './photos';
interface Stat { value: string; accent?: string; label: string }
interface Props { kicker?: string; heading: string; stats?: Stat[]; class?: string }
const { kicker = 'Daniel Reyes · strength coach', heading, class: cls = '', stats = [
  { value: '15', accent: ' yrs', label: 'coaching' }, { value: '1,900', accent: '+', label: 'men coached' }, { value: 'Ex', label: 'physiotherapist' },
] } = Astro.props;
---
<section class:list={['relative overflow-hidden bg-bg text-fg', cls]}>
  <div class="grid lg:grid-cols-2">
    <div class="relative h-[60vh] lg:h-auto lg:min-h-[640px]">
      <img src={PHOTOS.daniel} alt="Daniel Reyes, strength coach" width="1400" height="2100" loading="lazy" class="absolute inset-0 size-full object-cover object-[50%_25%]" />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_55%,var(--color-bg)_100%)] lg:bg-[linear-gradient(90deg,transparent_60%,var(--color-bg)_100%)]" aria-hidden="true"></div>
    </div>
    <div class="flex items-center px-5 py-14 sm:px-8 lg:py-24 lg:pl-16">
      <div class="max-w-[36rem]">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">{kicker}</p>
        <h2 class="mt-4 font-display text-h2 font-extrabold uppercase">{heading}</h2>
        <dl class="mt-8 grid grid-cols-3 gap-4 border-y border-border py-6">
          {stats.map((s) => <div class="flex flex-col-reverse"><dt class="mt-1 text-sm text-fg-muted">{s.label}</dt><dd class="font-display text-5xl font-extrabold leading-none">{s.value}{s.accent && <span class:list={[s.accent.trim() === '+' ? 'text-primary' : 'text-2xl text-fg-muted']}>{s.accent}</span>}</dd></div>)}
        </dl>
        <div class="mt-6 space-y-4 text-lg text-fg/85"><slot /></div>
      </div>
    </div>
  </div>
</section>
