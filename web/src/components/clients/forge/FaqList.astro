---
interface Props { items: { q: string; a: string }[]; class?: string }
const { items, class: cls = '' } = Astro.props;
---
<dl class:list={['divide-y divide-current/15 border-y border-current/15', cls]}>
  {items.map((it) => (
    <div class="grid gap-2 py-6 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-8">
      <dt class="font-display text-2xl font-bold uppercase leading-tight">{it.q}</dt>
      <dd class="opacity-80">{it.a}</dd>
    </div>
  ))}
</dl>
