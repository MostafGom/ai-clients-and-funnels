---
interface Props { items: { q: string; a: string }[]; class?: string }
const { items, class: cls = '' } = Astro.props;
---
<dl class:list={['divide-y divide-border', cls]}>
  {items.map((it) => (
    <div class="grid gap-2 py-6 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-8">
      <dt class="font-display text-2xl font-semibold text-fg">{it.q}</dt>
      <dd class="text-fg-muted">{it.a}</dd>
    </div>
  ))}
</dl>
