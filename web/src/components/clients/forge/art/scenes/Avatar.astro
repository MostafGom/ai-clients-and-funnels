---
/** Round photo avatar for a client named in copy (public/forge/photos). Falls back to initials. */
import { clientPhoto } from '../../photos';
interface Props { who: string; size?: number; class?: string }
const { who, size = 64, class: cls = '' } = Astro.props;
const src = clientPhoto(who);
const initials = who.split(',')[0].split(/\s|&/).filter(Boolean).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
{src
  ? <img src={src} alt="" width={size} height={size} loading="lazy" class:list={['shrink-0 rounded-pill object-cover object-top ring-2 ring-primary', cls]} style={`width:${size}px;height:${size}px;border-radius:999px`} />
  : <span class:list={['grid shrink-0 place-items-center bg-surface-2 font-display font-bold text-primary ring-2 ring-primary', cls]} style={`width:${size}px;height:${size}px;border-radius:999px;font-size:${size * 0.4}px`} aria-hidden="true">{initials}</span>}
