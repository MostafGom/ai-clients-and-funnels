---
interface Props { size?: number; class?: string }
const { size = 56, class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 64 64" width={size} height={size} class={cls} aria-hidden="true">
  <circle cx="32" cy="32" r="29" fill="none" stroke="var(--color-accent)" stroke-width="1.25" />
  <text x="32" y="43" text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-weight="700" font-size="34" fill="currentColor">F</text>
</svg>
