---
/**
 * The Forge signature moment: a barbell that loads plate by plate as the section scrolls through the viewport,
 * with the kilo and week counters climbing. Competition plate colours mapped to tokens.
 * Fully loaded and static under reduced motion or without JS. `to` = total kg (bar is 20).
 */
interface Props { to?: number; from?: number; weeks?: number; class?: string; caption?: string }
const { to = 140, from = 20, weeks = 12, class: cls = '', caption } = Astro.props;
const KINDS = [
  { kg: 25, w: 34, h: 236, fill: 'var(--color-primary)' },
  { kg: 20, w: 30, h: 236, fill: 'var(--color-accent-2)' },
  { kg: 15, w: 26, h: 236, fill: 'var(--color-accent)' },
  { kg: 10, w: 22, h: 236, fill: 'var(--color-success)' },
  { kg: 5, w: 18, h: 150, fill: 'var(--color-fg)' },
  { kg: 2.5, w: 14, h: 116, fill: 'var(--color-fg-muted)' },
];
// Per-side loading, heaviest first, at most two of each size so the bar fills in several visible steps.
// 25s only come in when the load needs them. Plates only ever get added, like a real bar.
let side = (to - 20) / 2; const plates: typeof KINDS = [];
for (const k of side > 105 ? KINDS : KINDS.slice(1)) for (let c = 0; c < 2 && side >= k.kg - 1e-9; c++) { plates.push(k); side -= k.kg; }
const offsets = plates.reduce<number[]>((a, p, i) => (a.push(i ? a[i - 1] + plates[i - 1].w + 3 : 0), a), []);
const C = 150; // bar centre y
---
<figure class:list={['plate-loader', cls]} data-plates data-from={from} data-to={to} data-weeks={weeks}>
  <div class="flex items-end justify-between gap-4 font-display font-extrabold uppercase leading-none">
    <p><span class="block text-sm font-body font-semibold tracking-[0.18em] text-fg-muted">Week</span><span class="text-[clamp(3rem,2rem+5vw,6.5rem)] tabular-nums" data-week aria-hidden="true">{weeks}</span></p>
    <p class="text-right"><span class="block text-sm font-body font-semibold tracking-[0.18em] text-fg-muted">On the bar</span><span class="text-[clamp(3rem,2rem+5vw,6.5rem)] text-primary tabular-nums" aria-hidden="true"><span data-kg>{to}</span><span class="ml-1 text-[0.45em] text-fg">kg</span></span></p>
  </div>
  <p class="sr-only">Week 1 to week {weeks}: the bar goes from {from} kg to {to} kg, a few kilos at a time.</p>
  <svg viewBox="0 0 1000 300" class="mt-4 w-full" aria-hidden="true">
    <rect x="20" y={C - 6} width="960" height="12" rx="3" fill="var(--color-border-strong)" />
    <rect x="292" y={C - 26} width="16" height="52" rx="2" fill="var(--color-fg-muted)" />
    <rect x="692" y={C - 26} width="16" height="52" rx="2" fill="var(--color-fg-muted)" />
    <rect x="308" y={C - 9} width="384" height="18" fill="var(--color-surface-2)" />
    {[...Array(24)].map((_, i) => <line x1={330 + i * 14} y1={C - 9} x2={338 + i * 14} y2={C + 9} stroke="var(--color-border-strong)" stroke-width="1.5" />)}
    {plates.map((p, i) => (
      <g class="plate" data-i={i} data-kg={p.kg}>
        <g class="plate-r" style={`--dx:60px`}><rect x={712 + offsets[i]} y={C - p.h / 2} width={p.w} height={p.h} rx="5" fill={p.fill} /><rect x={712 + offsets[i] + p.w / 2 - 1} y={C - p.h / 2 + 10} width="2" height={p.h - 20} fill="var(--color-bg)" opacity=".25" /></g>
        <g class="plate-l" style={`--dx:-60px`}><rect x={288 - offsets[i] - p.w} y={C - p.h / 2} width={p.w} height={p.h} rx="5" fill={p.fill} /><rect x={288 - offsets[i] - p.w / 2 - 1} y={C - p.h / 2 + 10} width="2" height={p.h - 20} fill="var(--color-bg)" opacity=".25" /></g>
      </g>
    ))}
  </svg>
  {caption && <figcaption class="mt-3 text-sm text-fg-muted">{caption}</figcaption>}
</figure>
<style>
  .plate-r, .plate-l { transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s; }
  [data-plates][data-live] .plate:not([data-on]) .plate-r, [data-plates][data-live] .plate:not([data-on]) .plate-l { transform: translateX(var(--dx)); opacity: 0; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-plates]').forEach((el) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const plates = [...el.querySelectorAll<SVGGElement>('.plate')];
    const kgEl = el.querySelector('[data-kg]')!, wkEl = el.querySelector('[data-week]')!;
    const weeks = Number(el.dataset.weeks);
    el.setAttribute('data-live', '');
    let last = -1, raf = 0, fired = false;
    const tick = () => {
      raf = 0;
      const r = el.getBoundingClientRect(), vh = innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 0.9 - r.top) / (vh * 0.55)));
      const n = Math.round(p * plates.length);
      if (n === last) return; last = n;
      let kg = 20;
      plates.forEach((g, i) => { const on = i < n; g.toggleAttribute('data-on', on); if (on) kg += 2 * Number(g.dataset.kg); });
      kgEl.textContent = String(kg);
      wkEl.textContent = String(Math.round(1 + (n / plates.length) * (weeks - 1)));
      if (n === plates.length && !fired && (fired = true)) window.funnel?.track('plates_loaded', {});
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(tick); };
    new IntersectionObserver(([e]) => { e.isIntersecting ? addEventListener('scroll', onScroll, { passive: true }) : removeEventListener('scroll', onScroll); onScroll(); }).observe(el);
    tick();
  });
</script>
