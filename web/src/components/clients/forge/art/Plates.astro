---
/** Thin-line barbell plates as a decorative mark. Deterministic sizes. */
interface Props { count?: number; class?: string; height?: number }
const { count = 5, class: cls = '', height } = Astro.props;
const sizes = [1, 0.8, 0.62, 0.48, 0.36, 0.28];
---
<svg viewBox="0 0 260 120" height={height} class={cls} aria-hidden="true" fill="none" stroke="var(--color-accent)" stroke-width="1.25">
  <line x1="0" y1="60" x2="260" y2="60" />
  {Array.from({ length: count }, (_, i) => { const r = 56 * (sizes[i] ?? 0.3); const x = 40 + i * 28; return <g><ellipse cx={x} cy="60" rx={r * 0.18} ry={r} /><ellipse cx={x} cy="60" rx={r * 0.18 * 0.5} ry={r * 0.5} opacity=".6" /></g>; })}
  <rect x="2" y="54" width="14" height="12" rx="2" fill="var(--color-inverse-2)" />
</svg>
