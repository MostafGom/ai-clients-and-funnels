---
/** Brass hairline, optionally with a centred serif numeral or word. The Forge divider. */
interface Props { label?: string; class?: string; tone?: 'brass' | 'muted' }
const { label, class: cls = '', tone = 'brass' } = Astro.props;
const line = tone === 'brass' ? 'bg-accent' : 'bg-border-strong';
---
<div class:list={['flex items-center gap-5', cls]} aria-hidden="true">
  <span class:list={['h-px flex-1', line]}></span>
  {label && <span class="font-display text-2xl italic text-accent">{label}</span>}
  {label && <span class:list={['h-px flex-1', line]}></span>}
</div>
