---
/**
 * Six lifts, week 1 vs week 12. Horizontal bars, display numerals, fills once on view: the page's one motion moment.
 * Values in kg (or any unit). `lifts`: [{ name, before, after }]
 */
interface Lift { name: string; before: number; after: number; unit?: string }
interface Props { lifts: Lift[]; unit?: string; caption?: string; compact?: boolean; class?: string }
const { lifts, unit = 'kg', caption, compact = false, class: cls = '' } = Astro.props;
const max = Math.max(...lifts.map((l) => l.after)) * 1.05;
---
<figure class:list={['ledger', cls]} data-ledger>
  <dl class:list={['space-y-3', compact ? 'text-xs' : 'text-sm']}>
    {lifts.map((l) => (
      <div class="grid grid-cols-[minmax(80px,1fr)_3fr_auto] items-center gap-3">
        <dt class="font-display text-lg font-bold uppercase">{l.name}</dt>
        <dd class="relative h-[14px]">
          <span class="bar absolute inset-y-0 left-0 rounded-sm bg-accent-2/40" style={`--w:${(l.before / max) * 100}%`}></span>
          <span class="bar after absolute inset-y-[3px] left-0 rounded-sm bg-primary" style={`--w:${(l.after / max) * 100}%`}></span>
        </dd>
        <dd class="whitespace-nowrap text-right font-display text-2xl font-bold tabular-nums"><span class="opacity-60">{l.before}</span> <span class="mx-1 text-primary">→</span> {l.after} <span class="text-xs font-body opacity-60">{l.unit ?? unit}</span></dd>
      </div>
    ))}
  </dl>
  <figcaption class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs opacity-80">
    <span class="inline-flex items-center gap-2"><i class="inline-block h-2 w-4 bg-accent-2/40"></i>week 1</span>
    <span class="inline-flex items-center gap-2"><i class="inline-block h-2 w-4 bg-primary"></i>week 12</span>
    {caption && <span class="basis-full">{caption}</span>}
  </figcaption>
</figure>
<style>
  .bar { width: 2%; transition: width 1.2s cubic-bezier(0.16, 1, 0.3, 1); }
  .bar.after { transition-delay: 0.2s; }
  [data-ledger][data-filled] .bar { width: var(--w); }
  @media (prefers-reduced-motion: reduce) { .bar { transition: none; } [data-ledger] .bar { width: var(--w); } }
</style>
<script>
  const els = document.querySelectorAll<HTMLElement>('[data-ledger]');
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.setAttribute('data-filled', ''); io.unobserve(e.target); } }), { threshold: 0.05, rootMargin: '0px 0px -10% 0px' });
  els.forEach((l) => io.observe(l));
</script>
