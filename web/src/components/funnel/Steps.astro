---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
interface Item { title: string; body: string }
interface Props { eyebrow?: string; headline: string; items: Item[] }
const { eyebrow = 'How it works', headline, items } = Astro.props;
---
<Container size="prose">
  <div class="text-center"><Eyebrow class="mb-4">{eyebrow}</Eyebrow><h2 class="text-h2 font-semibold">{headline}</h2></div>
  <ol class="mt-12 space-y-8">
    {items.map((it, i) => (
      <li class="flex gap-5">
        <span class="grid size-10 shrink-0 place-items-center rounded-pill bg-primary font-semibold text-primary-fg">{i + 1}</span>
        <div><h3 class="text-h3 font-semibold">{it.title}</h3><p class="mt-1 text-fg-muted">{it.body}</p></div>
      </li>
    ))}
  </ol>
</Container>
