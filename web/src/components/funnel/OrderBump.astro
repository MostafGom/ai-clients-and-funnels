---
/** The classic dashed-border "one-time offer" checkbox inside the checkout form. */
interface Props { title: string; price: string; description: string; priceKey?: string }
const { title, price, description, priceKey = 'bump' } = Astro.props;
---
<label class="mt-6 flex cursor-pointer gap-4 rounded-md border-2 border-dashed border-accent bg-surface p-5 transition hover:bg-surface-2 has-checked:border-primary has-checked:bg-primary-soft">
  <input type="checkbox" name="bump" value={priceKey} class="mt-1 size-5 shrink-0 accent-primary" />
  <span>
    <span class="block font-semibold text-fg">Yes! Add <span class="text-primary">{title}</span> for just {price}</span>
    <span class="mt-1 block text-sm text-fg-muted">{description}</span>
  </span>
</label>
