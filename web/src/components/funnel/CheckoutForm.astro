---
/**
 * Sends the buyer to Stripe Checkout. Plain POST (no JS required). Put an <OrderBump> in the slot
 * to add an optional second line item. Success lands on `successPath` with ?session_id=... which
 * the upsell page uses for one-click charges.
 */
import Button from '../ui/Button.astro';
interface Props {
  client: string;
  funnel: string;
  priceKey?: string;
  successPath: string;
  cancelPath: string;
  label?: string;
  class?: string;
}
const { client, funnel, priceKey = 'main', successPath, cancelPath, label = 'Complete my order', class: cls = '' } = Astro.props;
---
<form method="post" action="/api/checkout" class:list={['w-full', cls]} data-checkout>
  <input type="hidden" name="client" value={client} />
  <input type="hidden" name="funnel" value={funnel} />
  <input type="hidden" name="price" value={priceKey} />
  <input type="hidden" name="success" value={successPath} />
  <input type="hidden" name="cancel" value={cancelPath} />
  <slot />
  <Button type="submit" size="xl" full class="mt-6">{label}</Button>
  <p class="mt-3 flex items-center justify-center gap-2 text-xs text-fg-muted">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    Secure checkout powered by Stripe
  </p>
</form>
<script>
  document.querySelectorAll('form[data-checkout]').forEach((f) => f.addEventListener('submit', () => window.funnel?.track('checkout_started')));
</script>
