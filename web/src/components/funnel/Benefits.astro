---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
interface Item { title: string; body: string }
interface Props { eyebrow?: string; headline?: string; items: Item[]; columns?: 2 | 3 }
const { eyebrow, headline, items, columns = 3 } = Astro.props;
---
<Container>
  {(eyebrow || headline) && (
    <div class="mx-auto mb-12 max-w-2xl text-center">
      {eyebrow && <Eyebrow class="mb-4">{eyebrow}</Eyebrow>}
      {headline && <h2 class="text-h2 font-semibold">{headline}</h2>}
    </div>
  )}
  <div class:list={['grid gap-6', columns === 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2']}>
    {items.map((it, i) => (
      <div class="rounded-lg border border-border bg-surface p-7 shadow-card">
        <span class="font-display text-3xl text-primary">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-4 text-h3 font-semibold">{it.title}</h3>
        <p class="mt-2 text-fg-muted">{it.body}</p>
      </div>
    ))}
  </div>
</Container>
