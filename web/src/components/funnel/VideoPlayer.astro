---
/**
 * VSL player. Click-to-play (fast LCP), and after `revealAfter` seconds of playback it
 * sets [data-revealed] on every element with [data-reveal] on the page (delayed CTA pattern).
 * Set revealAfter={0} to reveal immediately.
 */
interface Props {
  provider: 'youtube' | 'vimeo' | 'wistia' | 'mp4';
  src: string; // id for youtube/vimeo/wistia, URL for mp4
  poster?: string;
  title?: string;
  revealAfter?: number;
  /** Small chip over the poster, e.g. "14 min · sound on". */
  caption?: string;
  class?: string;
}
const { provider, src, poster, title = 'Watch the video', revealAfter = 0, caption, class: cls = '' } = Astro.props;
const embed = {
  youtube: `https://www.youtube-nocookie.com/embed/${src}?autoplay=1&rel=0&modestbranding=1&playsinline=1`,
  vimeo: `https://player.vimeo.com/video/${src}?autoplay=1&title=0&byline=0&portrait=0`,
  wistia: `https://fast.wistia.net/embed/iframe/${src}?autoPlay=true`,
  mp4: src,
}[provider];
---
<div class:list={['vsl relative aspect-video overflow-hidden rounded-lg bg-inverse shadow-pop', cls]} data-vsl data-provider={provider} data-embed={embed} data-reveal-after={revealAfter}>
  {poster && <img src={poster} alt="" class="absolute inset-0 h-full w-full object-cover" loading="eager" />}
  <button type="button" class="group absolute inset-0 grid place-items-center" aria-label={title} data-vsl-play>
    <span class="grid size-20 place-items-center rounded-full bg-primary text-primary-fg shadow-cta transition-transform duration-300 ease-spring group-hover:scale-110">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
    </span>
  </button>
  {caption && <span class="pointer-events-none absolute bottom-4 left-4 rounded-pill bg-inverse-fg/90 px-3 py-1 text-xs font-semibold text-inverse">{caption}</span>}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-vsl]').forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>('[data-vsl-play]');
    const after = Number(el.dataset.revealAfter || 0);
    const key = `vsl-revealed:${location.pathname}`;
    const reveal = () => { document.querySelectorAll('[data-reveal]').forEach((n) => n.setAttribute('data-revealed', '')); try { localStorage.setItem(key, '1'); } catch {} };
    // Reveal immediately when: no delay, the visitor already unlocked it, or ?reveal=1 (ads/retargeting links).
    let seen = false; try { seen = localStorage.getItem(key) === '1'; } catch {}
    if (after === 0 || seen || new URLSearchParams(location.search).has('reveal')) reveal();
    btn?.addEventListener('click', () => {
      const embed = el.dataset.embed!;
      let media: HTMLElement;
      if (el.dataset.provider === 'mp4') {
        const v = document.createElement('video');
        Object.assign(v, { src: embed, autoplay: true, controls: true, playsInline: true });
        media = v;
      } else {
        const f = document.createElement('iframe');
        f.src = embed; f.allow = 'autoplay; fullscreen; picture-in-picture'; f.title = btn.getAttribute('aria-label') || 'Video';
        media = f;
      }
      media.className = 'absolute inset-0 h-full w-full border-0';
      el.replaceChildren(media);
      window.funnel?.track('vsl_play');
      if (after > 0) setTimeout(() => { reveal(); window.funnel?.track('vsl_cta_revealed', { after }); }, after * 1000);
    }, { once: true });
  });
</script>
