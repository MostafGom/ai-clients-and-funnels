---
import Container from '../ui/Container.astro';
interface Item { q: string; a: string }
interface Props { headline?: string; items: Item[] }
const { headline = 'Questions, answered', items } = Astro.props;
---
<Container size="prose">
  <h2 class="text-h2 font-semibold text-center">{headline}</h2>
  <div class="mt-10 divide-y divide-border rounded-lg border border-border bg-surface">
    {items.map((it) => (
      <details class="group p-6 open:bg-surface-2">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-fg">
          {it.q}
          <span class="grid size-7 shrink-0 place-items-center rounded-pill border border-border-strong transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-fg-muted">{it.a}</p>
      </details>
    ))}
  </div>
</Container>
